---
import { learnSolutions, delegateSolutions } from "../../data/solutions";

const base = import.meta.env.BASE_URL;

const badgeStyles: Record<"new" | "popular", string> = {
  new: "bg-amber-400 text-navy ring-2 ring-white",
  popular: "bg-teal text-white ring-2 ring-white",
};
---

<section id="solution" class="saimon-section bg-white" data-particles>
  <div class="saimon-shell">
    <div class="text-center mb-8">
      <p class="saimon-eyebrow">SAIMONのソリューション</p>
      <h2 class="mt-3 text-2xl sm:text-4xl font-heading font-black text-navy leading-tight">
        "育てる"と"任せる"、2つのかたち。
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base text-text-secondary leading-relaxed">
        SAIMONは、AI研修で社内人材を育てる「学ぶ」と、デザイン制作・Instagram運用・AI顧問をプロが引き受ける「任せる」の2つのかたちで、企業の"つくる力"を支えます。
      </p>
    </div>

    <!-- 学ぶ -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center justify-center px-3 py-1 rounded-full bg-navy text-white text-xs font-heading font-black tracking-wider">学ぶ</span>
        <h3 class="text-lg sm:text-xl font-heading font-black text-navy">社内に"つくる力"を育てる</h3>
      </div>
      <p class="text-sm text-text-secondary mb-6">自社でつくれる、を当たり前に。実践型のAI研修プログラム。</p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {learnSolutions.map((item) => (
          <a href={item.href} class="group relative saimon-card overflow-hidden hover:border-navy/25 hover:shadow-card-hover transition-all duration-300">
            {item.badge && (
              <span class:list={[
                "absolute top-3 right-3 z-10 inline-flex items-center justify-center px-2 py-0.5 text-[10px] font-heading font-black tracking-widest rounded-full shadow-md",
                badgeStyles[item.badge.tone],
              ]}>
                {item.badge.label}
              </span>
            )}
            <div class="aspect-[4/2.65] overflow-hidden">
              <img
                src={`${base}${item.image}`}
                alt=""
                class="h-full w-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <h4 class="text-lg font-heading font-black text-navy">{item.title}</h4>
              <p class="mt-2 min-h-[3rem] text-sm text-text-secondary leading-relaxed">{item.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-teal">
                詳しく見る
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- 任せる -->
    <div>
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center justify-center px-3 py-1 rounded-full bg-teal text-white text-xs font-heading font-black tracking-wider">任せる</span>
        <h3 class="text-lg sm:text-xl font-heading font-black text-navy">プロの"つくる力"を月額で</h3>
      </div>
      <p class="text-sm text-text-secondary mb-6">育てる時間がない領域は、SAIMONのチームが制作と伴走を引き受けます。</p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {delegateSolutions.map((item) => (
          <a href={item.href} class="group relative saimon-card overflow-hidden hover:border-navy/25 hover:shadow-card-hover transition-all duration-300">
            {item.badge && (
              <span class:list={[
                "absolute top-3 right-3 z-10 inline-flex items-center justify-center px-2 py-0.5 text-[10px] font-heading font-black tracking-widest rounded-full shadow-md",
                badgeStyles[item.badge.tone],
              ]}>
                {item.badge.label}
              </span>
            )}
            <div class="aspect-[4/2.65] overflow-hidden">
              <img
                src={`${base}${item.image}`}
                alt=""
                class="h-full w-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <h4 class="text-lg font-heading font-black text-navy">{item.title}</h4>
              <p class="mt-2 min-h-[3rem] text-sm text-text-secondary leading-relaxed">{item.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-teal">
                詳しく見る
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href="/services/" class="inline-flex items-center gap-2 text-sm font-bold text-navy hover:text-teal transition-colors">
        料金と対象を一覧で比べる
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
