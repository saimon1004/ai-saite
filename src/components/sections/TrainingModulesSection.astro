---
import { aiImpactLab } from "../../data/services";

const base = import.meta.env.BASE_URL;
const { modules } = aiImpactLab;
---

<section id="modules" class="py-12 sm:py-16" data-particles>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-12">
      <p class="font-heading text-xs tracking-[0.2em] text-teal uppercase font-bold mb-3">
        研修プログラム
      </p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-black text-navy leading-tight">
        <span class="text-teal">知る</span> ・ <span class="text-teal">考える</span> ・ <span class="text-teal">実践する</span>。
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base text-text-secondary leading-relaxed">
        最新のAIトレンドを<strong class="text-navy">知り</strong>、自社で何ができそうかを<strong class="text-navy">考え</strong>、実際に手を動かして<strong class="text-navy">やってみる</strong>。<br class="hidden sm:block" />
        この3段階を <strong class="text-teal">ひとつの研修パッケージ</strong> でまとめて習得します。
      </p>
    </div>

    <!-- 3-stage flow -->
    <div class="relative">
      <div class="grid gap-5 lg:gap-3 lg:grid-cols-[1fr_auto_1fr_auto_1fr] items-stretch">
        {modules.map((mod, idx) => (
          <>
            {/* Stage card */}
            <article class="relative rounded-2xl overflow-hidden bg-white border border-border shadow-card hover:shadow-card-hover transition-shadow duration-300 group flex flex-col">
              {/* Image header */}
              <div class="relative aspect-[16/8] overflow-hidden">
                <img
                  src={`${base}${mod.image}`}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div
                  class="absolute inset-0"
                  style={`background: linear-gradient(135deg, ${mod.overlayColor} 0%, rgba(0,0,0,0.45) 100%);`}
                  aria-hidden="true"
                ></div>
                {/* Step badge */}
                <div class="absolute top-4 left-4">
                  <span class="inline-block px-3 py-1 rounded-full text-[10px] font-heading font-black tracking-widest uppercase bg-white/95 text-navy">
                    STEP {mod.number}
                  </span>
                </div>
                {/* Big stage title */}
                <div class="absolute inset-x-0 bottom-0 p-5">
                  <p class="text-[10px] font-heading font-bold tracking-[0.2em] uppercase text-teal-light mb-1">
                    {mod.subtitle}
                  </p>
                  <h3 class="text-3xl sm:text-4xl font-heading font-black text-white drop-shadow">
                    {mod.title}
                  </h3>
                </div>
              </div>

              {/* Body */}
              <div class="p-5 sm:p-6 flex-1 flex flex-col">
                <p class="text-sm text-text-secondary leading-relaxed mb-4">
                  {mod.description}
                </p>
                <ul class="space-y-2 mb-4 flex-1">
                  {mod.learns.map((item) => (
                    <li class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-teal shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-sm font-bold text-text-primary leading-snug">{item}</span>
                    </li>
                  ))}
                </ul>
                {mod.tools && mod.tools.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border">
                    {mod.tools.map((tool) => (
                      <span class="text-[11px] font-bold text-teal bg-teal/8 border border-teal/20 px-2.5 py-1 rounded-full">
                        {tool}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>

            {/* Arrow between cards (desktop only, hidden after last) */}
            {idx < modules.length - 1 && (
              <div class="hidden lg:flex items-center justify-center px-1" aria-hidden="true">
                <svg class="w-7 h-7 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 12h15" />
                </svg>
              </div>
            )}
          </>
        ))}
      </div>
    </div>

    <!-- Bottom emphasis: ワンパッケージ -->
    <div class="mt-8 sm:mt-10 rounded-2xl p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center gap-5"
      style="background: linear-gradient(135deg, rgba(13,0,132,0.04) 0%, rgba(49,185,181,0.10) 100%); border-left: 4px solid #31b9b5;">
      <div class="shrink-0 flex h-14 w-14 items-center justify-center rounded-full bg-teal text-white">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
        </svg>
      </div>
      <div class="flex-1">
        <p class="font-heading font-black text-navy text-base sm:text-lg leading-snug">
          インプット → アイデア → 実装を、ワンサイクルで。
        </p>
        <p class="mt-1.5 text-sm text-text-secondary leading-relaxed">
          "知る" だけでも "考える" だけでも、現場は動きません。<strong class="text-navy">3 段階を1つのパッケージで完結</strong>させるから、研修の翌日から組織が動き出します。
        </p>
      </div>
      <a href="#contact" class="shrink-0 inline-flex items-center justify-center gap-2 bg-teal text-white font-bold text-sm px-5 py-2.5 rounded-md hover:bg-teal-dark transition-colors whitespace-nowrap">
        相談する
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </div>
</section>
