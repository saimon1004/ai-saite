---
// TODO: 掲載許諾が取れた企業から順に実名（社名・ロゴ）へ差し替えること。
// 許諾が取れるまでは業種＋提供内容の匿名表記で運用（架空の声・コメントは載せない）。
interface Client {
  industry: string;
  scale: string;
  service: string;
}

const clients: Client[] = [
  {
    industry: "美容業",
    scale: "サロン運営",
    service: "AI実務研修（2日間）",
  },
  {
    industry: "冠婚葬祭互助会",
    scale: "大手グループ",
    service: "AI研修・制作支援",
  },
  {
    industry: "サービス業",
    scale: "グループ企業",
    service: "AI実務研修・継続支援",
  },
];
---

<section id="clients" class="saimon-section bg-white">
  <div class="saimon-shell">
    <div class="text-center mb-8">
      <p class="saimon-eyebrow">導入企業</p>
      <h2 class="mt-3 text-2xl sm:text-3xl font-heading font-black text-navy leading-tight" style="text-wrap: balance;">
        <span class="whitespace-nowrap">さまざまな業界で</span><wbr /><span class="whitespace-nowrap">"つくる力"が</span><wbr /><span class="whitespace-nowrap">動き出しています</span>
      </h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      {clients.map((c) => (
        <div class="saimon-card p-6 text-center">
          <p class="text-lg font-heading font-black text-navy">{c.industry}</p>
          <p class="mt-1 text-xs text-text-secondary">{c.scale}</p>
          <p class="mt-4 inline-flex items-center px-3 py-1 rounded-full bg-teal/10 text-teal text-xs font-bold">{c.service}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-xs text-text-secondary">※ 掲載企業は順次追加予定です。</p>
  </div>
</section>
