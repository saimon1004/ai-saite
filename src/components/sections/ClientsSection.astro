---
interface Client {
  name: string;
  industry: string;
  service: string;
}

// 実名掲載は許諾済みの3社のみ（NASH / ShamMake / マイキャリア）。他は匿名表記。
const clients: Client[] = [
  {
    name: "NASH",
    industry: "大手アクティビティ事業",
    service: "採用サイト改善・AI活用支援",
  },
  {
    name: "ShamMake",
    industry: "観光ポータルサイト運営",
    service: "AI実務研修",
  },
  {
    name: "マイキャリア",
    industry: "採用支援",
    service: "採用HP内製化プログラム",
  },
  {
    name: "大手冠婚葬祭グループ",
    industry: "冠婚葬祭・互助会",
    service: "AI研修・制作支援",
  },
  {
    name: "不動産仲介会社",
    industry: "不動産",
    service: "AI実務研修",
  },
  {
    name: "コンサルティング会社",
    industry: "会計コンサルティング",
    service: "AI実務研修・継続支援",
  },
];
---

<section id="clients" class="saimon-section bg-white overflow-hidden" data-particles>
  <div class="saimon-shell">
    <div class="text-center mb-8">
      <p class="saimon-eyebrow">導入企業</p>
      <h2 class="mt-3 text-2xl sm:text-3xl font-heading font-black text-navy leading-tight" style="text-wrap: balance;">
        <span class="whitespace-nowrap">さまざまな業界で</span><wbr /><span class="whitespace-nowrap">"つくる力"が</span><wbr /><span class="whitespace-nowrap">動き出しています</span>
      </h2>
    </div>
  </div>

  <div class="clients-marquee" aria-label="導入企業一覧">
    <div class="clients-track">
      <div class="clients-group">
        {clients.map((c) => (
          <div class="clients-card saimon-card">
            <p class="text-lg font-heading font-black text-navy leading-snug">{c.name}</p>
            <p class="mt-1 text-xs text-text-secondary">{c.industry}</p>
            <p class="mt-3 inline-flex items-center px-3 py-1 rounded-full bg-teal/10 text-teal text-xs font-bold">{c.service}</p>
          </div>
        ))}
      </div>
      <div class="clients-group" aria-hidden="true">
        {clients.map((c) => (
          <div class="clients-card saimon-card">
            <p class="text-lg font-heading font-black text-navy leading-snug">{c.name}</p>
            <p class="mt-1 text-xs text-text-secondary">{c.industry}</p>
            <p class="mt-3 inline-flex items-center px-3 py-1 rounded-full bg-teal/10 text-teal text-xs font-bold">{c.service}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <p class="mt-6 text-center text-xs text-text-secondary relative z-[1]">※ 掲載企業は順次追加予定です。</p>
</section>

<style>
  .clients-marquee {
    overflow: hidden;
    position: relative;
    z-index: 1;
    /* 端をふわっと消すマスク */
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .clients-track {
    display: flex;
    width: max-content;
    animation: clients-scroll 32s linear infinite;
  }

  .clients-marquee:hover .clients-track {
    animation-play-state: paused;
  }

  .clients-group {
    display: flex;
    gap: 20px;
    padding-right: 20px;
  }

  .clients-card {
    width: 240px;
    flex-shrink: 0;
    padding: 22px 20px;
    text-align: center;
    word-break: keep-all;
  }

  @keyframes clients-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .clients-group[aria-hidden="true"] {
      display: none;
    }
    .clients-group {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
    }
    .clients-marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
