---
const reasons = [
  {
    title: "実践重視のカリキュラム",
    description: "現場の課題を解決する実践的な内容にフォーカス。",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15l-1.5 15h-12L4.5 3zM9 7.5h6M8.25 11.25h7.5" /></svg>`,
  },
  {
    title: "伴走型サポート",
    description: "研修後もプロのメンターが定着・活用まで支援。",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m5-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    title: "柔軟なカスタマイズ",
    description: "業種・職種・レベルに合わせた最適なプランを設計。",
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a2.25 2.25 0 11-4.5 0m4.5 0a2.25 2.25 0 10-4.5 0M3.75 6H6m4.5 12h9.75m-9.75 0a2.25 2.25 0 11-4.5 0m4.5 0a2.25 2.25 0 10-4.5 0m-2.25 0H6m9-6h5.25M15 12a2.25 2.25 0 11-4.5 0m4.5 0a2.25 2.25 0 10-4.5 0m-6.75 0h6.75" /></svg>`,
  },
];
---

<section id="results" class="saimon-section bg-[#eefbff] soft-grid">
  <div class="saimon-shell">
    <div class="text-center mb-10">
      <p class="saimon-eyebrow">選ばれる理由</p>
      <h2 class="mt-3 text-2xl sm:text-3xl font-heading font-black text-navy">
        成果につながる、SAIMONのこだわり
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {reasons.map((item) => (
        <div class="text-center md:border-r md:last:border-r-0 border-navy/15 px-5">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-navy">
            <Fragment set:html={item.icon} />
          </div>
          <h3 class="text-base font-heading font-black text-navy">{item.title}</h3>
          <p class="mt-2 text-sm text-text-secondary leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
