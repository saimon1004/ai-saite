---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import SkillBadge from "../components/blog/SkillBadge.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import ReadingProgress from "../components/blog/ReadingProgress.astro";
import TrainingCta from "../components/blog/TrainingCta.astro";
import AiTutor from "../components/ai-tutor/AiTutor.astro";
import { getArcByChapter } from "../data/blog-meta";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      subtitle: string;
      description: string;
      pubDate: Date;
      chapter: number;
      arc: string;
      arcName: string;
      skills: { category: string; name: string; level: string }[];
      estimatedMinutes: number;
    };
  };
  headings: Heading[];
}

const { post, headings } = Astro.props;
const { data } = post;
const arc = getArcByChapter(data.chapter);

// Arc-specific accent colors for hero decoration
const arcAccents: Record<string, { blur1: string; blur2: string; border: string }> = {
  founding: { blur1: "rgba(49,185,181,0.18)", blur2: "rgba(13,0,132,0.12)", border: "rgba(49,185,181,0.15)" },
  growth:  { blur1: "rgba(59,130,246,0.18)", blur2: "rgba(13,0,132,0.10)", border: "rgba(59,130,246,0.15)" },
  crisis:  { blur1: "rgba(239,68,68,0.15)",  blur2: "rgba(13,0,132,0.12)", border: "rgba(239,68,68,0.12)" },
  scale:   { blur1: "rgba(168,85,247,0.16)", blur2: "rgba(49,185,181,0.10)", border: "rgba(168,85,247,0.12)" },
  beyond:  { blur1: "rgba(234,179,8,0.16)",  blur2: "rgba(13,0,132,0.10)", border: "rgba(234,179,8,0.12)" },
};
const accent = arcAccents[data.arc] || arcAccents.founding;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  author: {
    "@type": "Organization",
    name: "株式会社SAIMON",
    url: "https://sai-mon.co.jp",
  },
  publisher: {
    "@type": "Organization",
    name: "株式会社SAIMON",
  },
  isPartOf: {
    "@type": "CreativeWorkSeries",
    name: `CodeQuest - ${data.arcName}`,
  },
};
---

<BaseLayout
  title={`${data.title} | 無料研修`}
  description={data.description}
  jsonLd={jsonLd}
>
  <Header />
  <ReadingProgress />

  <main class="min-h-screen">
    <!-- Article Hero -->
    <div class="relative overflow-hidden pt-8 pb-14" style={`background: linear-gradient(180deg, rgba(13,0,132,0.04) 0%, transparent 100%);`}>
      <!-- Dot grid pattern -->
      <div class="absolute inset-0 opacity-[0.35]" style="background-image: radial-gradient(circle, rgba(13,0,132,0.15) 1px, transparent 1px); background-size: 24px 24px;" />

      <!-- Decorative blur shapes (arc-colored) -->
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full blur-[100px] pointer-events-none" style={`background: ${accent.blur1};`} />
      <div class="absolute -bottom-16 -left-24 w-64 h-64 rounded-full blur-[80px] pointer-events-none" style={`background: ${accent.blur2};`} />

      <!-- Chapter number watermark -->
      <div class="absolute top-8 right-6 sm:right-12 font-heading font-black text-[8rem] sm:text-[12rem] leading-none text-navy/[0.03] pointer-events-none select-none">
        {String(data.chapter).padStart(2, "0")}
      </div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-text-secondary mb-6" aria-label="パンくず">
          <a href="/" class="hover:text-navy transition-colors">ホーム</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-navy transition-colors">無料研修</a>
          <span>/</span>
          <a href={`/blog/series/${data.arc}/`} class="hover:text-navy transition-colors">{data.arcName}</a>
          <span>/</span>
          <span class="text-text-primary">Ch.{data.chapter}</span>
        </nav>

        <!-- Arc & Chapter -->
        <div class="flex items-center gap-3 mb-4">
          <span class="px-3 py-1.5 rounded-full text-xs font-bold text-navy" style={`background: ${accent.border}; border: 1px solid ${accent.border};`}>
            {arc?.emoji} {data.arcName}
          </span>
          <span class="text-sm font-medium text-text-secondary">
            Chapter {String(data.chapter).padStart(2, "0")}
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-navy leading-tight mb-3">
          {data.title}
        </h1>
        <p class="text-lg text-text-secondary mb-6">{data.subtitle}</p>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-text-secondary mb-6">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            約{data.estimatedMinutes}分
          </span>
          <time datetime={data.pubDate.toISOString()}>
            {data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </div>

        <!-- Skills -->
        <div class="flex flex-wrap gap-2">
          {data.skills.map((skill) => (
            <SkillBadge category={skill.category} name={skill.name} level={skill.level} />
          ))}
        </div>
      </div>

      <!-- Bottom wave separator -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
          <path d="M0 48h1440V24C1320 4 1200 0 1080 8 960 16 840 40 720 44 600 48 480 32 360 24 240 16 120 16 60 20L0 24z" fill="white"/>
        </svg>
      </div>
    </div>

    <!-- Content Area -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <TableOfContents headings={headings} />
      <article class="prose-blog">
        <slot />
        <TrainingCta />
      </article>
    </div>
  </main>

  <AiTutor
    chapterId={post.id}
    chapterNumber={data.chapter}
    chapterTitle={data.title}
    arcName={data.arcName}
  />

  <Footer />
</BaseLayout>
