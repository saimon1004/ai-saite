---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import SkillBadge from "../components/blog/SkillBadge.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import ReadingProgress from "../components/blog/ReadingProgress.astro";
import TrainingCta from "../components/blog/TrainingCta.astro";
import AiTutor from "../components/ai-tutor/AiTutor.astro";
import BlogIllustration from "../components/blog/BlogIllustration.astro";
import { getArcByChapter } from "../data/blog-meta";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      subtitle: string;
      description: string;
      pubDate: Date;
      chapter: number;
      arc: string;
      arcName: string;
      skills: { category: string; name: string; level: string }[];
      estimatedMinutes: number;
    };
  };
  headings: Heading[];
}

const { post, headings } = Astro.props;
const { data } = post;
const arc = getArcByChapter(data.chapter);
const base = import.meta.env.BASE_URL;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  author: {
    "@type": "Organization",
    name: "株式会社SAIMON",
    url: "https://sai-mon.co.jp",
  },
  publisher: {
    "@type": "Organization",
    name: "株式会社SAIMON",
  },
  isPartOf: {
    "@type": "CreativeWorkSeries",
    name: `CodeQuest - ${data.arcName}`,
  },
};
---

<BaseLayout
  title={`${data.title} | 無料研修`}
  description={data.description}
  jsonLd={jsonLd}
>
  <Header />
  <ReadingProgress />

  <main class="min-h-screen">
    <section class="bg-white border-b border-border">
      <div class="saimon-shell py-6">
        <nav class="flex flex-wrap items-center gap-2 text-xs text-text-secondary mb-5" aria-label="パンくず">
          <a href="/" class="hover:text-navy transition-colors">ホーム</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-navy transition-colors">無料研修</a>
          <span>/</span>
          <a href={`/blog/series/${data.arc}/`} class="hover:text-navy transition-colors">{data.arcName}</a>
          <span>/</span>
          <span class="text-text-primary">Ch.{data.chapter}</span>
        </nav>

        <div class="grid gap-6 lg:grid-cols-[1fr_300px] lg:items-start">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1.5 rounded-md text-xs font-bold text-navy bg-teal/10 border border-teal/20">
                {arc?.emoji} {data.arcName}
              </span>
              <span class="text-sm font-bold text-text-secondary">
                Ch.{String(data.chapter).padStart(2, "0")}
              </span>
            </div>

            <h1 class="text-3xl sm:text-4xl font-heading font-black text-navy leading-tight">
              {data.title}
            </h1>
            <p class="mt-2 text-lg text-text-secondary">{data.subtitle}</p>

            <div class="mt-5 flex flex-wrap items-center gap-4 text-sm text-text-secondary">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                約{data.estimatedMinutes}分
              </span>
              <time datetime={data.pubDate.toISOString()}>
                {data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </div>

            <div class="mt-5 flex flex-wrap gap-2">
              {data.skills.map((skill) => (
                <SkillBadge category={skill.category} name={skill.name} level={skill.level} />
              ))}
            </div>

            <div class="image-frame mt-6 aspect-[16/7] overflow-hidden rounded-md">
              <BlogIllustration chapter={data.chapter} size="hero" />
            </div>
          </div>

          <aside class="saimon-card p-5 lg:sticky lg:top-24">
            <p class="text-xs font-heading font-black text-teal">AIチューターからのアドバイス</p>
            <div class="mt-4 flex justify-center">
              <div class="relative h-28 w-28 rounded-[1.2rem] border border-navy/15 bg-white shadow-card">
                <div class="absolute left-1/2 top-7 h-14 w-20 -translate-x-1/2 rounded-[1rem] bg-navy">
                  <span class="absolute left-4 top-5 h-3 w-3 rounded-full bg-teal"></span>
                  <span class="absolute right-4 top-5 h-3 w-3 rounded-full bg-teal"></span>
                </div>
                <span class="absolute left-1/2 top-2 h-5 w-px -translate-x-1/2 bg-navy/40"></span>
                <span class="absolute left-1/2 top-0 h-2 w-2 -translate-x-1/2 rounded-full bg-teal"></span>
                <span class="absolute bottom-3 left-5 h-5 w-5 rounded-full border border-navy/20"></span>
                <span class="absolute bottom-3 right-5 h-5 w-5 rounded-full border border-navy/20"></span>
              </div>
            </div>
            <p class="mt-4 text-sm text-text-secondary leading-relaxed">
              見出しタグは、ページの構造をクローラーにも大切な受講者にも伝える目印です。分からない箇所はチューターに質問できます。
            </p>
            <button
              type="button"
              data-open-tutor
              class="mt-5 w-full rounded-md border border-navy px-4 py-3 text-sm font-bold text-navy hover:bg-navy hover:text-white transition-colors"
            >
              質問する
            </button>
          </aside>
        </div>
      </div>
    </section>

    <!-- Content Area -->
    <div class="saimon-shell grid gap-8 py-10 lg:grid-cols-[240px_1fr]">
      <div class="lg:sticky lg:top-24 lg:h-fit">
        <TableOfContents headings={headings} />
      </div>
      <article class="prose-blog min-w-0">
        <slot />
        <TrainingCta />
      </article>
    </div>
  </main>

  <AiTutor
    chapterId={post.id}
    chapterNumber={data.chapter}
    chapterTitle={data.title}
    arcName={data.arcName}
  />

  <Footer />
</BaseLayout>
