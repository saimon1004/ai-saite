---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import { loadDefaultJapaneseParser } from "budoux";

// ヒーローの端末に載せる字幕は幅が狭く、word-break:keep-all だけだと折り返せずはみ出す。
// ビルド時に文節境界へ ZWSP を入れておく。
const jpParser = loadDefaultJapaneseParser();
const phrase = (t: string) => jpParser.parse(t).join("\u200b");

const base = import.meta.env.BASE_URL;
// CSSはXserverで1年間キャッシュされるため、内容変更時はバージョンを上げてキャッシュバストする
const cssVersion = "20260731-v8";
const cssHref = `${base}video-faq/styles.css?v=${cssVersion}`;

const heroImg = `${base}video-faq/assets/hero-bg.jpg`;
const heroImgM = `${base}video-faq/assets/hero-bg-m.jpg`;
// ヒーローに並べる3画面。サンプル動画から切り出した実際の話し手を使う。
// 年齢・性別・画風の振れ幅が一目で分かる並びにしている。
const heroPhones = [
  { slug: "insurance", alt: "保険・共済・互助会の回答動画。50代の女性が話している画面。", caption: phrase("その場でお調べします。"), side: "left" },
  { slug: "recruit", alt: "採用サイトの回答動画。20代の男性が話している画面。", caption: phrase("未経験の方、大歓迎です。"), side: "main" },
  { slug: "realestate", alt: "不動産賃貸仲介の回答動画。イラストのキャラクターが話している画面。", caption: phrase("今週のおすすめを二件、"), side: "right" },
];

const pageUrl = "https://sai-mon.co.jp/video-faq/";
// 実演デモ（ほんりゅう提供の動作確認用サンプルサイト。別業種・架空企業である旨をページ本文に明記する）
const demoUrl = "https://sunrise-travel-recruit.vercel.app";

const faqEntity = {
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "保険商品の説明に使って、法令上の問題はありませんか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "よくある質問への補助的な説明としてご利用いただくことを前提にしています。重要事項説明や契約締結前交付書面を動画で代替するものではありません。募集行為に当たる内容を扱う場合は、貴社のコンプライアンス部門の確認を前提に、台本のレビュー工程を挟んで進めます。",
      },
    },
    {
      "@type": "Question",
      name: "導入までどれくらいかかりますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "タグの設置自体は最短即日です。全体の期間は動画の本数と撮り方で変わるため、ご相談の際に目安をお伝えします。時間がかかるのは動画の準備なので、そこはSAIMONがまとめてお引き受けします。",
      },
    },
    {
      "@type": "Question",
      name: "高齢のお客様でも操作できますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "質問をタップするだけです。SAIMONが制作する動画には字幕を焼き込んでお渡しするので、音を出せない場所でも、聞き取りにくい方でも内容を読めます。",
      },
    },
    {
      "@type": "Question",
      name: "動画は何本くらい必要ですか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "月額プランに回答動画5本の制作が含まれるので、まずは5本から始めます。公開後に視聴データを見ながら、よく見られている質問の周辺を足していくのが効果的です。",
      },
    },
    {
      "@type": "Question",
      name: "動画は誰が作るのですか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SAIMONが質問の洗い出しと台本作成から対応します。担当者に出ていただく実写撮影と、AIアバターでの生成のどちらにも対応できます。",
      },
    },
    {
      "@type": "Question",
      name: "既存のサイトに影響はありませんか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "ウィジェットはサイト本体の表示を妨げない独立したJavaScriptです（実測 gzip 約18KB）。CSSも独自のスコープで管理しているため、既存サイトのデザインには干渉しません。",
      },
    },
    {
      "@type": "Question",
      name: "どんなサイトに入れられますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "HTMLが書き込めるサイトであれば導入できます。WordPress、Studio、ペライチなどノーコードで作られたサイトでも、HTMLを挿入する機能があれば設置できます。",
      },
    },
    {
      "@type": "Question",
      name: "効果はどうやって測るのですか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "起動回数、動画の再生数、視聴完了率、よく見られている質問、訪問者数を管理画面で確認できます。",
      },
    },
    {
      "@type": "Question",
      name: "料金はいくらですか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "初期構築費用は0円です。1アカウントにつき回答動画5本がついて、月額50,000円（税別）。動画の制作費も月額に含みます。動画の追加や複数サイトへの設置は、個別にご相談ください。",
      },
    },
    {
      "@type": "Question",
      name: "契約期間や解約の条件は？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "個別のご契約でお取り決めします。ご相談の段階で条件をお伝えします。",
      },
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sai-mon.co.jp/#organization",
      name: "株式会社SAIMON",
      url: "https://sai-mon.co.jp/",
      logo: "https://sai-mon.co.jp/logo.png",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "顔の見えるFAQ",
      serviceType: "動画FAQチャットボットの導入・運用支援（保険・EC・採用ほか）",
      description:
        "Webサイトにタグを貼るだけで導入できる動画FAQチャットボット。よくある質問に担当者が動画で答えます。保険・共済・互助会、ECサイト、採用サイトなどで活用でき、質問設計から動画制作までSAIMONが対応します。",
      url: pageUrl,
      provider: { "@id": "https://sai-mon.co.jp/#organization" },
      areaServed: "JP",
      audience: {
        "@type": "Audience",
        audienceType: "保険会社・共済・冠婚葬祭互助会・ECサイト運営企業・採用担当企業",
      },
      offers: {
        "@type": "Offer",
        name: "1アカウント",
        price: "50000",
        priceCurrency: "JPY",
        description:
          "初期構築費用0円。1アカウントにつき回答動画5本の制作、埋め込みタグの発行と設置サポート、管理画面、視聴データの確認を含む月額プラン（税別）。",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "50000",
          priceCurrency: "JPY",
          valueAddedTaxIncluded: false,
          billingIncrement: 1,
          unitCode: "MON",
        },
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://sai-mon.co.jp/" },
        { "@type": "ListItem", position: 2, name: "顔の見えるFAQ", item: pageUrl },
      ],
    },
    faqEntity,
  ],
};
---

<BaseLayout
  title="顔の見えるFAQ｜タグ1行で入る動画FAQチャットボット"
  description="動画で答えるFAQチャットボット「顔の見えるFAQ」。初期構築費用0円、動画5本つきで月額50,000円（税別）。Webサイトにタグを貼るだけなので設置は最短即日です。保険・共済・互助会、ECサイト、採用サイトなどで、文章では伝わりにくい質問に担当者が動画で答えます。質問の洗い出しから字幕入りの動画制作までSAIMONがお引き受けします。"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <!-- 研修LP向けのFAQ動画チャットボット（BaseLayout共通）は、本LPで売る商品とは別実装のため誤認を避けて非表示にする -->
    <style is:global>#faq-chatbot-root { display: none !important; }</style>
  </Fragment>
  <link rel="preload" as="image" href={heroImg} slot="head" />
  <link rel="stylesheet" href={cssHref} slot="head" />

  <Header />

  <main class="vfaq-lp-scope">
    <!-- 01 Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <picture class="hero-media" aria-hidden="true">
        <source media="(max-width: 640px)" srcset={heroImgM} />
        <img src={heroImg} alt="" decoding="async" fetchpriority="high" />
      </picture>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker">タグ1行で入る、動画で答えるFAQ</p>
          <h1 id="hero-title">顔の見えるFAQ</h1>
          <p class="hero-lead jp-budoux">よくある質問に、担当者が動画で答えます。Webサイトにタグを貼るだけなので、設置は最短即日。時間がかかる動画の準備は、SAIMONがまとめて引き受けます。</p>
          <ul class="hero-facts">
            <li class="hero-fact-zero"><span class="hero-fact-value">初期構築費用 0円</span></li>
            <li><span class="hero-fact-value">動画5本つきで月額50,000円<small>（税別）</small></span></li>
          </ul>
          <div class="hero-actions">
            <a class="primary-cta" href={`${base}video-faq/samples/`} data-cta-source="hero-demo">サンプルを見る<span aria-hidden="true">→</span></a>
            <a class="secondary-cta" href="#contact-form" data-cta-source="hero-primary">無料相談する</a>
          </div>
          <p class="hero-note jp-budoux">話し手は自社の担当者でも、AIアバターでも選べます。</p>
        </div>
        <div class="hero-devices">
          {heroPhones.map((p) => (
            <div class={`hero-phone hero-phone-${p.side}`}>
              <img src={`${base}video-faq/hero-phones/${p.slug}.jpg`} width="320" height="569" alt={p.alt} decoding="async" fetchpriority="high" />
              <span class="hero-phone-caption">{p.caption}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 Problem -->
    <section class="problem section-block" aria-labelledby="problem-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">Problem</p>
          <h2 id="problem-title"><span class="no-break">その質問、今週も</span><wbr /><span class="no-break">何度答えましたか</span></h2>
          <p class="section-lead jp-budoux">業種は違っても、問い合わせの現場で起きていることは同じです。</p>
        </div>
        <ul class="problem-grid">
          <li class="problem-card">
            <h3>同じ質問への対応に、毎日時間を取られている</h3>
            <p class="jp-budoux">「未経験でも大丈夫ですか」「返品はできますか」「解約したらいくら戻りますか」。答えは決まっているのに、毎回人が対応しています。</p>
          </li>
          <li class="problem-card">
            <h3>文章のFAQでは、不安が消えない</h3>
            <p class="jp-budoux">知りたいのはページに書いてある一般論ではなく「自分の場合はどうなるか」です。文字だけでは、そこまで届きません。</p>
          </li>
          <li class="problem-card">
            <h3>動画を入れたいが、抱えるものが多い</h3>
            <p class="jp-budoux">撮影、配信の仕組み、更新の運用。外注すれば高くつき、内製すれば運用が残ります。だから後回しになります。</p>
          </li>
          <li class="problem-card">
            <h3>説明の質が、担当者によってばらつく</h3>
            <p class="jp-budoux">誰が答えても同じ説明になっているか、確かめる手段がありません。</p>
          </li>
        </ul>
        <p class="problem-close jp-budoux">この4つは、答える人の顔と声が見えるだけで大きく変わります。</p>
      </div>
    </section>

    <!-- 03 How it works -->
    <section class="how section-block" aria-labelledby="how-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">How it works</p>
          <h2 id="how-title"><span class="no-break">質問をタップすると、</span><wbr /><span class="no-break">動画が再生されるだけ</span></h2>
          <p class="section-lead jp-budoux">導入も運用も、専門知識は必要ありません。</p>
        </div>
        <ol class="step-list">
          <li class="step-item">
            <span class="step-num" aria-hidden="true">1</span>
            <div class="step-body">
              <h3>Webサイトにタグを貼る</h3>
              <p class="jp-budoux">発行されたタグを、貴社サイトに貼り付けます。ページを作り直す必要はありません。</p>
            </div>
          </li>
          <li class="step-item">
            <span class="step-num" aria-hidden="true">2</span>
            <div class="step-body">
              <h3>質問と回答動画を登録する</h3>
              <p class="jp-budoux">管理画面からカテゴリ・質問・回答動画を登録します。登録した内容はすぐサイトに反映されます。</p>
            </div>
          </li>
          <li class="step-item">
            <span class="step-num" aria-hidden="true">3</span>
            <div class="step-body">
              <h3>お客様が質問をタップする</h3>
              <p class="jp-budoux">サイト右下のボタンから質問を選ぶと、回答動画が再生されます。SAIMONが作る動画は字幕入りなので、音を出せない場所でも読めます。</p>
            </div>
          </li>
          <li class="step-item">
            <span class="step-num" aria-hidden="true">4</span>
            <div class="step-body">
              <h3>視聴データを確認する</h3>
              <p class="jp-budoux">どの質問がよく見られているか、最後まで見られているかを管理画面で確認できます。</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- 04 Use cases -->
    <section id="usecase" class="usecase section-block" aria-labelledby="usecase-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">Use cases</p>
          <h2 id="usecase-title"><span class="no-break">どの質問を動画にするかが、</span><wbr /><span class="no-break">業種ごとの違いです</span></h2>
          <p class="section-lead jp-budoux">ウィジェットの動きと設置の手軽さはどの業種でも同じです。変わるのは中身だけなので、貴社の質問に置き換えて考えてみてください。</p>
        </div>
        <ul class="usecase-grid">
          <li class="usecase-item">
            <p class="usecase-tag">保険・共済・互助会</p>
            <h3>文章にすると長くなる質問を、動画で</h3>
            <p class="jp-budoux">「解約したらいくら戻るのか」「どこまで保障されるのか」「申込みから開始までの流れ」。電話が集中しがちな質問を動画にします。高齢の加入者にも、読まずに受け取ってもらえます。</p>
            <p class="usecase-note jp-budoux">よくある質問への補助的な説明としての利用が前提です。重要事項説明の代替にはなりません。</p>
          </li>
          <li class="usecase-item">
            <p class="usecase-tag">ECサイト</p>
            <h3>写真と説明文では判断がつかない質問を、動画で</h3>
            <p class="jp-budoux">「サイズはどう選ぶのか」「素材の質感はどうか」「返品と交換の手順」。購入前の問い合わせが減り、思っていたものと違ったという理由の返品も減らせます。</p>
          </li>
          <li class="usecase-item">
            <p class="usecase-tag">採用サイト</p>
            <h3>求人票では伝わらない質問を、動画で</h3>
            <p class="jp-budoux">「未経験でも大丈夫か」「1日の仕事の流れ」「職場の雰囲気」。実際に働いている人が答えることで、応募前の不安を減らせます。</p>
          </li>
        </ul>
        <p class="usecase-close jp-budoux">ここに挙げていない業種でも、よく聞かれる質問が5つあれば始められます。</p>
      </div>
    </section>

    <!-- 04.5 More: 広告的な使い方 -->
    <section id="more" class="more section-block" aria-labelledby="more-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">More</p>
          <h2 id="more-title"><span class="no-break">答えるだけでなく、</span><wbr /><span class="no-break">こちらから見せる使い方も</span></h2>
          <p class="section-lead jp-budoux">質問に答える形だけでなく、見てほしいものを前に出す使い方もできます。動画のあとに好きなページへ飛ぶボタンを置けるので、見せて終わりになりません。</p>
        </div>
        <ul class="usecase-grid">
          <li class="usecase-item">
            <p class="usecase-tag">不動産賃貸仲介</p>
            <h3>今週のおすすめ物件</h3>
            <p class="jp-budoux">カテゴリを「今週のおすすめ物件」にして、1件ずつ内見動画を並べます。動画のあとに「この物件を見る」ボタンを置けば、そのまま物件ページへ送れます。毎週の入れ替えは管理画面で動画と見出しを差し替えるだけで、サイト側に手を入れる必要はありません。</p>
          </li>
          <li class="usecase-item">
            <p class="usecase-tag">ECサイト</p>
            <h3>今月の新作紹介</h3>
            <p class="jp-budoux">新作を1本ずつ動画で見せて、そのまま商品ページへ送ります。写真では伝わらない質感や着用イメージを、買う前に確かめてもらえます。</p>
          </li>
          <li class="usecase-item">
            <p class="usecase-tag">スクール・教室</p>
            <h3>体験会のご案内</h3>
            <p class="jp-budoux">講師本人が教室の雰囲気と当日の流れを話し、申込みフォームへ送ります。誰に教わるのかが先に分かるので、申込みの心理的な壁が下がります。</p>
          </li>
        </ul>
        <p class="fine-print jp-budoux">動画のあとに置けるボタンは、任意のURLを開くもの、別のカテゴリへ移動するもの、別の質問へ移動するものの3種類です。ボタンの色も個別に指定できます。内容の入れ替えは管理画面から行います。</p>
      </div>
    </section>

    <!-- 05 Demo -->
    <section id="demo" class="demo section-block" aria-labelledby="demo-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">Demo</p>
          <h2 id="demo-title"><span class="no-break">実際に触って</span><wbr /><span class="no-break">確かめてください</span></h2>
          <p class="section-lead jp-budoux">保険・EC・採用・不動産の4つのシチュエーションで、実際の回答動画をご覧いただけます。音声のオンオフや閉じるボタンの操作感は、サイトに設置したときと同じです。話し手も、実写風のアバターからイラストのキャラクターまで並べています。</p>
        </div>
        <a class="primary-cta" href={`${base}video-faq/samples/`} data-cta-source="demo-section">サンプルを見る<span aria-hidden="true">→</span></a>
        <p class="fine-print jp-budoux">サンプルの内容はすべて架空の企業を想定したものです。実在の企業・商品とは関係ありません。実際にサイトへ設置した状態を確認されたい場合は、<a href={demoUrl} target="_blank" rel="noopener">動作確認用のデモサイト</a>もご覧いただけます。</p>
      </div>
    </section>

    <!-- 06 Features -->
    <section class="features section-block" aria-labelledby="features-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">Features</p>
          <h2 id="features-title">機能</h2>
        </div>
        <ul class="feature-grid">
          <li class="feature-card">
            <h3>タグを貼るだけで導入できる</h3>
            <p class="jp-budoux">HTMLが書き込めるサイトならどこでも動きます。サイトを作り直す必要はありません。</p>
          </li>
          <li class="feature-card">
            <h3>ブランドカラーに合わせられる</h3>
            <p class="jp-budoux">ボタンやヘッダーの色を、貴社のブランドカラーに変更できます。</p>
          </li>
          <li class="feature-card">
            <h3>カテゴリで整理できる</h3>
            <p class="jp-budoux">質問が増えても、カテゴリで分けて選びやすい状態を保てます。</p>
          </li>
