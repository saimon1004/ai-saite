---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import { company } from "../data/company";

const base = import.meta.env.BASE_URL;

interface DaySchedule {
  day: string;
  title: string;
  duration: string; // ex. "13:00 - 16:30（3.5時間）"
  goals: string[];
  schedule: { time: string; topic: string }[];
}

interface Course {
  id: string;
  label: string;
  level?: string;
  summary: string;
  totalHours: string;
  hoursBreakdown: string;
  practiceRatio?: string;
  practiceRatioNote?: string;
  purposes: string[];
  targets: string[];
  tools: string[];
  days: DaySchedule[];
}

const courses: Course[] = [
  {
    id: "ai",
    label: "ビギナーコース",
    level: "BEGINNER",
    summary: "生成AIを初めて本格的に業務で扱う方を対象とした、実践的な入門プログラム。マーケティング・人事・CS・管理業務など、部門横断で即日使えるスキルを習得します。",
    totalHours: "計11時間 / 3日間",
    hoursBreakdown: "3.5h ＋ 3.5h ＋ 4h",
    practiceRatio: "30 ： 70",
    practiceRatioNote: "実習中心の構成。受講当日から業務に持ち帰れる成果物を作ります。",
    purposes: [
      "AIの実践的な活用を体験し、具体的なアクションプランを策定",
      "組織内でDXを推進できるリーダー人材を育成",
      "全社的な取り組みを通じて、組織の結束力を高める",
    ],
    targets: ["中小企業の社員・チーム", "AI活用で業務改善を目指す方"],
    tools: ["ChatGPT", "Claude", "Gemini", "NotebookLM", "Manus", "Make"],
    days: [
      {
        day: "DAY 1",
        title: "生成AI基礎",
        duration: "13:00 - 16:30（3.5時間）",
        goals: [
          "AI導入の可能性を理解する",
          "主要ツールの特徴と使い分けをマスターする",
          "マーケティング業務への即時応用を学ぶ",
        ],
        schedule: [
          { time: "13:00 - 13:30", topic: "オリエンテーション・ゴール設定" },
          { time: "13:30 - 14:30", topic: "AIツール比較（ChatGPT / Claude / Gemini / NotebookLM）" },
          { time: "14:30 - 14:45", topic: "休憩" },
          { time: "14:45 - 15:30", topic: "企業導入事例の紹介" },
          { time: "15:30 - 16:30", topic: "マーケティングワークフロー自動化（コピーライティング・アイデア創出・画像生成）" },
        ],
      },
      {
        day: "DAY 2",
        title: "バックオフィス効率化",
        duration: "13:00 - 16:30（3.5時間）",
        goals: [
          "バックオフィス業務の自動化手法を習得する",
          "NotebookLMでナレッジ管理を実践する",
          "音声テキスト処理スキルを身につける",
        ],
        schedule: [
          { time: "13:00 - 13:15", topic: "振り返り・体験共有" },
          { time: "13:15 - 14:15", topic: "人事活用（面接書き起こし・評価支援）" },
          { time: "14:15 - 14:30", topic: "休憩" },
          { time: "14:30 - 15:30", topic: "管理業務自動化（会議録・文書作成）" },
          { time: "15:30 - 16:30", topic: "カスタマーサービス改善（FAQ自動化・対応品質向上）" },
        ],
      },
      {
        day: "DAY 3",
        title: "実践ワークショップ — 自社業務への AI 実装",
        duration: "13:00 - 17:00（4時間）",
        goals: [
          "DAY 1〜2 で学んだ AI ツールを自社の実務課題に適用する",
          "チームで業務改善プロトタイプを設計・実装する",
          "研修後すぐに展開できるアクションプランを策定する",
        ],
        schedule: [
          { time: "13:00 - 13:30", topic: "イントロダクション・自社課題の整理" },
          { time: "13:30 - 14:15", topic: "業務課題のヒアリング & AI活用案ブレスト（DAY 1〜2 の学びを棚卸し）" },
          { time: "14:15 - 14:30", topic: "休憩" },
          { time: "14:30 - 15:30", topic: "チーム別プロトタイプ制作（プロンプト・ワークフロー設計）" },
          { time: "15:30 - 16:15", topic: "成果物の実装・検証（実データを使ったハンズオン）" },
          { time: "16:15 - 16:45", topic: "チーム発表・相互フィードバック" },
          { time: "16:45 - 17:00", topic: "社内展開ロードマップ策定・Q&A" },
        ],
      },
    ],
  },
  {
    id: "advanced",
    label: "アドバンスドコース",
    level: "ADVANCED",
    summary: "ビギナーコース修了者、または既にAIツールを業務で活用している方向けの実装フォーカス型プログラム。最新トレンドのキャッチアップから自社業務への組み込み・実装までを2日間で完結します。",
    totalHours: "計10時間 / 2日間",
    hoursBreakdown: "5h ＋ 5h",
    practiceRatio: "20 ： 80",
    practiceRatioNote: "実装ハンズオン中心。研修内で動く成果物を完成させます。",
    purposes: [
      "既存のAI活用を一段階引き上げ、業務の本格的な改善・自動化を実現する",
      "自社固有の業務課題にAIを組み込み、実装まで手を動かして完了する",
      "社内展開・運用設計まで含む、実装リーダー人材を育成する",
    ],
    targets: ["ビギナーコース修了者", "既にAIを業務活用している方・DX推進担当者・部門リーダー"],
    tools: ["Claude Code", "Manus", "Make", "n8n", "Dify", "MCP", "NotebookLM", "Notion AI"],
    days: [
      {
        day: "DAY 1",
        title: "知る ＋ 考える — 最新トレンドのキャッチアップと自社業務への適用設計",
        duration: "13:00 - 18:15（5時間 ／ 休憩15分）",
        goals: [
          "最新のAIツール・トレンドを体系的にキャッチアップする",
          "他社の活用事例から自社への応用ポイントを抽出する",
          "自社業務に対するAI適用案を構造化し、優先順位付けする",
        ],
        schedule: [
          { time: "13:00 - 13:15", topic: "オリエンテーション・自社状況のシェア" },
          { time: "13:15 - 14:15", topic: "【知る】最新AIトレンド総ざらい（LLM最新動向・AIエージェント・MCP・ノーコード統合）" },
          { time: "14:15 - 15:00", topic: "【知る】業界・職種別の他社活用事例ショーケース" },
          { time: "15:00 - 15:15", topic: "休憩" },
          { time: "15:15 - 16:15", topic: "【考える】自社業務の棚卸しワーク（バリューチェーン・タスクマッピング）" },
          { time: "16:15 - 17:15", topic: "【考える】AI適用ポイントの抽出・優先順位付け（インパクト × 実現性）" },
          { time: "17:15 - 18:15", topic: "【考える】改善プロトタイプの企画書化（プロンプト設計・ツール選定まで）" },
        ],
      },
      {
        day: "DAY 2",
        title: "実践する — 自社向けAI実装ハンズオン",
        duration: "13:00 - 18:15（5時間 ／ 休憩15分）",
        goals: [
          "DAY 1 で設計したプランを実装し、動く成果物を完成させる",
          "LLM・エージェント・ノーコード・統合ツールを駆使して業務に組み込む",
          "社内展開・運用設計まで落とし込んだロードマップを持ち帰る",
        ],
        schedule: [
          { time: "13:00 - 13:30", topic: "DAY 1 振り返り・実装プラン最終確認" },
          { time: "13:30 - 15:00", topic: "【実践】実装ハンズオン①（基本ワークフロー構築・プロンプト・データ接続）" },
          { time: "15:00 - 15:15", topic: "休憩" },
          { time: "15:15 - 16:30", topic: "【実践】実装ハンズオン②（AIエージェント・自動化フロー組み込み）" },
          { time: "16:30 - 17:30", topic: "【実践】検証・チューニング・成果物の磨き込み" },
          { time: "17:30 - 18:00", topic: "チーム発表・相互フィードバック" },
          { time: "18:00 - 18:15", topic: "社内展開ロードマップ策定・Q&A" },
        ],
      },
    ],
  },
  {
    id: "web",
    label: "HP制作の内製化コース",
    level: "SPECIALIZED",
    summary: "AI共創開発で、社内メンバーがWebサイトの制作・更新を担える体制をつくります。Claude Codeを使ってサイト設計・構築・運用までを習得します。",
    totalHours: "計11時間 / 3日間",
    hoursBreakdown: "3.5h ＋ 3.5h ＋ 4h",
    practiceRatio: "30 ： 70",
    practiceRatioNote: "実習中心の構成。受講当日から業務に持ち帰れる成果物を作ります。",
    purposes: [
      "Claude Codeを活用し、自社でHP制作・更新ができる体制を構築",
      "AIと協働してWebサイトを構築できるリーダー人材を育成",
      "CMS連携とデプロイ手法を習得し、継続的な運用体制を確立",
    ],
    targets: ["広報・採用・営業チーム", "Web制作を内製化したい企業"],
    tools: ["Claude Code", "VS Code", "React / Next.js", "MicroCMS", "Git", "Xserver"],
    days: [
      {
        day: "DAY 1",
        title: "Claude Code基礎と環境構築",
        duration: "13:00 - 16:30（3.5時間）",
        goals: [
          "Claude Codeの仕組みと操作方法を理解する",
          "AI共創開発の基本概念を習得する",
          "開発環境のセットアップを完了する",
        ],
        schedule: [
          { time: "13:00 - 13:30", topic: "オリエンテーション・ゴール設定" },
          { time: "13:30 - 14:30", topic: "Claude Code概論（AI共創開発の考え方・役割分担）" },
          { time: "14:30 - 14:45", topic: "休憩" },
          { time: "14:45 - 15:30", topic: "環境構築実習（VS Code・Claude Code・Git導入）" },
          { time: "15:30 - 16:30", topic: "Claude Code基本操作（Planモード・権限設定・プロジェクト初期化）" },
        ],
      },
      {
        day: "DAY 2",
        title: "サイト設計・構築実践",
        duration: "13:00 - 16:30（3.5時間）",
        goals: [
          "要件定義からサイト構築までの流れを体験する",
          "React / Next.jsでのサイト構築をAIと実践する",
          "デザイン修正・機能実装の手法を習得する",
        ],
        schedule: [
          { time: "13:00 - 13:15", topic: "振り返り・体験共有" },
          { time: "13:15 - 14:15", topic: "要件定義と技術選定（参考サイト分析・プロンプト設計）" },
          { time: "14:15 - 14:30", topic: "休憩" },
          { time: "14:30 - 15:30", topic: "サイト構築ハンズオン（React / Next.jsプロジェクト作成）" },
          { time: "15:30 - 16:30", topic: "デザイン修正・機能追加（CTA・レスポンシブ対応）" },
        ],
      },
      {
        day: "DAY 3",
        title: "デプロイ・運用と実践ワークショップ — 自社HPのプロトタイプ制作",
        duration: "13:00 - 17:00（4時間）",
        goals: [
          "CMS連携による運用体制を構築する",
          "サーバーデプロイの手順を習得する",
          "自社HP制作のアクションプランを策定する",
        ],
        schedule: [
          { time: "13:00 - 13:30", topic: "イントロダクション・DAY2の復習" },
          { time: "13:30 - 14:15", topic: "CMS導入（MicroCMS連携・動的コンテンツ管理）" },
          { time: "14:15 - 14:30", topic: "休憩" },
          { time: "14:30 - 15:15", topic: "デプロイ実践（サーバー設定・ドメイン設定）" },
          { time: "15:15 - 16:15", topic: "実践ワークショップ（自社HPのプロトタイプ制作）" },
          { time: "16:15 - 16:30", topic: "プレゼンテーション・まとめ" },
          { time: "16:30 - 17:00", topic: "Q&A・アクションプラン策定" },
        ],
      },
    ],
  },
];

const features = [
  "実際に活用できるスキル習得",
  "内製化によるコスト削減",
  "助成金で最大75%を支援",
  "伴走サポートで定着・活用",
];

function buildOverview(course: Course): [string, string, string][] {
  return [
    ["研修時間", course.totalHours, course.hoursBreakdown],
    ["実施形式", "オンライン or 対面", "Google Meet またはご訪問"],
    ["講義 ：実習", course.practiceRatio ?? "30 ： 70", "実習中心の構成"],
    ["研修費", "¥400,000 / 人", "助成金活用で実質 ¥100,000〜"],
  ];
}
---

<BaseLayout
  title="助成金活用プラン | AI IMPACT LAB | 株式会社SAIMON"
  description="人材開発支援助成金（リスキリング支援コース）を活用したAI研修パッケージ。計11時間／3日間で、実践型AI研修とHP制作内製化研修により社内DX推進人材を育成します。"
>
  <Header />

  <main class="bg-white">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-navy text-white">
      <div class="absolute inset-y-0 right-0 hidden w-1/2 lg:block" aria-hidden="true">
        <img src={`${base}pillar-genba.jpg`} alt="" class="h-full w-full object-cover opacity-78" />
        <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/40 to-transparent"></div>
      </div>
      <div class="relative saimon-shell py-16 sm:py-20">
        <p class="saimon-eyebrow">Subsidy Plan</p>
        <h1 class="mt-4 max-w-2xl text-4xl sm:text-5xl font-heading font-black leading-tight text-white">
          AI IMPACT LAB<br />助成金活用プラン
        </h1>
        <p class="mt-5 max-w-xl text-sm sm:text-base text-white/76 leading-relaxed">
          人材開発支援助成金（リスキリング支援コース）を活用して、AI人材の育成と業務変革を無理なく推進。<br class="hidden sm:block" />
          <strong class="text-white">レベル別の3コース</strong>から、貴社の状況に最適な実践型プログラムをお選びいただけます。
        </p>
      </div>
    </section>

    <!-- Tabs + Features -->
    <section class="border-b border-border bg-white">
      <div class="saimon-shell -mt-7 relative z-10">
        <div class="grid sm:grid-cols-3 rounded-md overflow-hidden shadow-card">
          {courses.map((course, index) => (
            <button
              type="button"
              data-tab-btn={course.id}
              class:list={[
                "px-5 py-4 text-sm font-bold transition-colors",
                index === 0 ? "bg-teal text-white" : "bg-white text-navy hover:bg-surface-dim",
              ]}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {course.label}
            </button>
          ))}
        </div>

        <div class="grid gap-3 py-6 sm:grid-cols-2 lg:grid-cols-4">
          {features.map((feature) => (
            <div class="saimon-card px-4 py-4 text-center">
              <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-md bg-navy/5 text-navy">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-xs font-bold text-text-primary">{feature}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Course content -->
    <section class="saimon-section">
      <div class="saimon-shell">
        {courses.map((course, index) => (
          <div data-tab-content={course.id} class:list={[index !== 0 && "hidden"]}>
            <div class="text-center mb-9">
              <p class="saimon-eyebrow">プラン概要</p>
              <h2 class="mt-3 text-2xl sm:text-3xl font-heading font-black text-navy">{course.label}</h2>
              <p class="mt-4 max-w-2xl mx-auto text-sm text-text-secondary leading-relaxed">{course.summary}</p>
            </div>

            <!-- Overview stats -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {buildOverview(course).map(([label, value, note]) => (
                <div class="saimon-card p-5 text-center">
                  <p class="text-xs font-bold text-teal">{label}</p>
                  <p class="mt-2 text-base sm:text-lg font-heading font-black text-navy">{value}</p>
                  {note && <p class="mt-1 text-[11px] text-text-secondary">{note}</p>}
                </div>
              ))}
            </div>

            <!-- Purpose + Tools -->
            <div class="mt-8 grid gap-5 lg:grid-cols-[1.2fr_1fr]">
              <div class="saimon-card p-6">
                <p class="saimon-eyebrow">研修の目的</p>
                <ul class="mt-4 space-y-3">
                  {course.purposes.map((p, i) => (
                    <li class="flex gap-3 items-start">
                      <span class="shrink-0 flex h-6 w-6 items-center justify-center rounded-full bg-teal/12 text-teal text-xs font-heading font-black">{i + 1}</span>
                      <span class="text-sm text-text-primary leading-relaxed">{p}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-5 pt-5 border-t border-border">
                  <p class="text-xs font-bold text-teal">対象</p>
                  <p class="mt-2 text-sm font-bold text-text-primary">{course.targets.join(" ／ ")}</p>
                </div>
              </div>

              <div class="saimon-card p-6">
                <p class="saimon-eyebrow">使用ツール（一例）</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {course.tools.map((tool) => (
                    <span class="rounded-md border border-border bg-surface-dim px-3 py-2 text-xs font-bold text-text-primary">{tool}</span>
                  ))}
                  <span class="rounded-md border border-dashed border-teal/40 bg-teal/5 px-3 py-2 text-xs font-bold text-teal">ほか</span>
                </div>
                <p class="mt-3 text-[11px] text-text-secondary leading-relaxed">
                  ※ 上記は代表的なツールの一部です。生成AI領域は進化が速いため、<strong class="text-navy">研修実施タイミングで最も実用的かつ最新のツール</strong>に随時アップデートしてご提供します。
                </p>
                <div class="mt-6 rounded-md bg-teal/10 border border-teal/20 p-4">
                  <p class="text-xs font-bold text-teal">講義 ： 実習</p>
                  <p class="mt-1 text-2xl font-heading font-black text-navy">{course.practiceRatio ?? "30 ： 70"}</p>
                  <p class="mt-1 text-xs text-text-secondary">{course.practiceRatioNote ?? "実習中心の構成。受講当日から業務に持ち帰れる成果物を作ります。"}</p>
                </div>
              </div>
            </div>

            <!-- Full curriculum -->
            <div class="mt-10">
              <div class="text-center mb-7">
                <p class="saimon-eyebrow">カリキュラム（{course.totalHours}）</p>
                <h3 class="mt-2 text-xl sm:text-2xl font-heading font-black text-navy">研修スケジュール</h3>
              </div>

              <div class="space-y-5">
                {course.days.map((d, i) => (
                  <article class="saimon-card overflow-hidden">
                    <header class="grid gap-2 sm:grid-cols-[auto_1fr_auto] items-baseline px-5 sm:px-6 py-4 bg-navy text-white">
                      <p class="font-heading font-black text-teal-light tracking-wider text-sm">{d.day}</p>
                      <h4 class="font-heading font-black text-base sm:text-lg leading-tight">{d.title}</h4>
                      <p class="text-xs font-bold text-white/85 sm:text-right">{d.duration}</p>
                    </header>
                    <div class="grid gap-0 lg:grid-cols-[1fr_1.4fr] divide-y lg:divide-y-0 lg:divide-x divide-border">
                      <!-- Goals -->
                      <div class="p-5 sm:p-6">
                        <p class="text-xs font-bold text-teal mb-3">学習目標</p>
                        <ul class="space-y-2">
                          {d.goals.map((g) => (
                            <li class="flex gap-2 items-start">
                              <svg class="w-4 h-4 text-teal shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                              <span class="text-sm text-text-primary leading-snug">{g}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <!-- Schedule -->
                      <div class="p-5 sm:p-6">
                        <p class="text-xs font-bold text-teal mb-3">タイムスケジュール</p>
                        <ul class="space-y-2">
                          {d.schedule.map((s) => {
                            const isBreak = /休憩/.test(s.topic);
                            return (
