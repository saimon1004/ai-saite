---
import SinglePageLayout from "../layouts/SinglePageLayout.astro";
import PageBanner from "../components/common/PageBanner.astro";
import Budoux from "../components/common/Budoux.astro";
import SolutionList from "../components/common/SolutionList.astro";
import { company } from "../data/company";
import { learnSolutions, delegateSolutions, type Solution } from "../data/solutions";

const groups: { key: string; label: string; heading: string; tone: string; items: Solution[] }[] = [
  { key: "learn", label: "学ぶ", heading: "社内に\"つくる力\"を育てる", tone: "bg-navy", items: learnSolutions },
  { key: "delegate", label: "任せる", heading: "プロの\"つくる力\"を月額で", tone: "bg-teal", items: delegateSolutions },
];

const all = [...learnSolutions, ...delegateSolutions];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "株式会社SAIMONのサービス一覧",
      itemListElement: all.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Service",
          name: s.serviceName ?? s.title,
          description: s.description,
          provider: { "@id": `${company.url}/#organization` },
          audience: { "@type": "Audience", audienceType: s.target },
          ...(s.href !== "/contact/" && { url: `${company.url}${s.href}` }),
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: `${company.url}/` },
        { "@type": "ListItem", position: 2, name: "サービス一覧", item: `${company.url}/services/` },
      ],
    },
  ],
};
---

<SinglePageLayout
  title="サービス一覧｜AI研修・Instagram運用・デザイン制作"
  description="株式会社SAIMONのサービス一覧。企業向けAI研修、助成金活用プラン、石垣島AI研修、採用HP内製化、飲食店のInstagram運用「おまかせグラム」、サブスクデザイン、顔の見えるFAQ、AI顧問の対象と料金の目安を比べられます。"
  jsonLd={jsonLd}
>
  <PageBanner
    eyebrow="Services"
    title="サービス一覧"
    lead="社内に&quot;つくる力&quot;を育てる研修と、制作・運用・伴走をプロが引き受けるサービス。対象と料金の目安をまとめました。"
    image="solutions/solution-advisor.jpg"
    breadcrumb={[{ label: "ホーム", href: "/" }, { label: "サービス一覧" }]}
  />

  {groups.map((group) => (
    <section class:list={["saimon-section", group.key === "learn" ? "bg-white" : "bg-surface"]} aria-labelledby={`group-${group.key}`}>
      <div class="saimon-shell">
        <div class="flex items-center gap-3 mb-8">
          <span class:list={["inline-flex items-center justify-center px-3 py-1 rounded-full text-white text-xs font-heading font-black", group.tone]}>
            {group.label}
          </span>
          <h2 id={`group-${group.key}`} class="text-xl sm:text-2xl font-heading font-black text-navy">{group.heading}</h2>
        </div>

        <SolutionList items={group.items} />
      </div>
    </section>
  ))}

  <section class="bg-navy py-11 sm:py-14">
    <div class="saimon-shell text-center">
      <h2 class="jp-budoux text-xl sm:text-2xl font-heading font-black text-white">どれが合うか分からない場合も、まずはご相談ください</h2>
      <a href="/contact/" class="mt-6 inline-flex items-center gap-2 bg-teal text-white font-bold text-sm px-8 py-3.5 rounded-md hover:bg-teal-dark transition-colors">
        無料で相談する
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <Budoux />
</SinglePageLayout>
