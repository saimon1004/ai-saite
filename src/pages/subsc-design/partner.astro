  <script is:inline>
    (function () {
      const FORM_ENDPOINT = "https://recruit-hp-form-api.vercel.app/api/contact";

      const form = document.getElementById("lead-form");
      if (!form) return;

      const feedback = document.getElementById("form-feedback");
      const submitBtn = form.querySelector(".lead-form-submit");

      // API側の獲得経路ホワイトリストに合わせる。LPの識別は UTM_campaign の既定値で行う
      function resolveSource() {
        return "LP無料相談";
      }

      function collectUtm() {
        try {
          const url = new URL(window.location.href);
          return {
            utmSource: url.searchParams.get("utm_source") || "",
            utmCampaign: url.searchParams.get("utm_campaign") || "subsc-design-partner-lp",
          };
        } catch (_) {
          return { utmSource: "", utmCampaign: "subsc-design-partner-lp" };
        }
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "送信中...";
        feedback.className = "form-feedback";
        feedback.textContent = "";

        const data = new FormData(form);
        const utm = collectUtm();
        const eventId =
          (window.crypto && crypto.randomUUID && crypto.randomUUID()) ||
          String(Date.now()) + Math.random().toString(16).slice(2);
        const payload = {
          source: resolveSource(),
          company: data.get("company"),
          name: data.get("name"),
          email: data.get("email"),
          phone: data.get("phone"),
          challenges: data.get("challenges"),
          consent: data.get("consent") === "yes",
          website: data.get("website") || "",
          utmSource: utm.utmSource,
          utmCampaign: utm.utmCampaign,
          eventId: eventId,
          pageUrl: window.location.href,
        };

        try {
          const res = await fetch(FORM_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));

          if (!res.ok) {
            throw new Error(body.error || "送信に失敗しました");
          }

          feedback.classList.add("is-success");
          feedback.textContent =
            body.message || "お問い合わせを受け付けました。1営業日以内にご連絡いたします。";
          form.reset();
          submitBtn.textContent = "送信完了";

          if (typeof window.gtag === "function") {
            window.gtag("event", "generate_lead", {
              event_category: "form",
              event_label: payload.source,
            });
          }

          if (typeof window.fbq === "function") {
            window.fbq(
              "track",
              "Lead",
              { content_name: payload.source },
              { eventID: eventId }
            );
          }
        } catch (err) {
          feedback.classList.add("is-error");
          feedback.textContent =
            err.message ||
            "送信に失敗しました。お手数ですが info@sai-mon.co.jp まで直接ご連絡ください。";
          submitBtn.disabled = false;
          submitBtn.innerHTML = '送信する <span aria-hidden="true">→</span>';
        }
      });

      // ===== 計測: GA4ファネルイベント（既存 gtag / BaseLayout 側で読み込み済み） =====
      function track(name, params) {
        try { if (typeof window.gtag === "function") window.gtag("event", name, params || {}); } catch (_) {}
      }

      var stickyCta = document.getElementById("mobile-sticky-cta");
      var formSection = document.getElementById("contact-form");

      // 追従CTAの表示制御: ヒーロー（scroll-world・専用CTAあり）表示中とフォーム表示中は隠す
      var heroVisible = true;
      var formVisible = false;
      function syncStickyCta() {
        if (stickyCta) stickyCta.classList.toggle("is-hidden", heroVisible || formVisible);
      }
      syncStickyCta();

      // フォーム到達（form_view・1回のみ）
      var formViewed = false;
      if (formSection && "IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            formVisible = e.isIntersecting;
            syncStickyCta();
            if (e.isIntersecting && !formViewed) {
              formViewed = true;
              track("lp_form_view", { event_category: "subsc_partner_funnel" });
            }
          });
        }, { threshold: 0.01 });
        io.observe(formSection);
      }

      var heroWorld = document.getElementById("hero-world");
      if (heroWorld && "IntersectionObserver" in window) {
        var heroIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            heroVisible = e.isIntersecting;
            syncStickyCta();
          });
        }, { threshold: 0.01 });
        heroIo.observe(heroWorld);
      } else {
        heroVisible = false;
        syncStickyCta();
      }

      // CTAクリック（data-cta-source 別）
      document.querySelectorAll("[data-cta-source]").forEach(function (el) {
        el.addEventListener("click", function () {
          track("lp_cta_click", { event_category: "subsc_partner_funnel", event_label: el.getAttribute("data-cta-source") });
        });
      });

      // フォーム入力開始（最初のフォーカス・1回のみ）
      var formStarted = false;
      if (form) {
        form.addEventListener("focusin", function () {
          if (formStarted) return;
          formStarted = true;
          track("lp_form_start", { event_category: "subsc_partner_funnel" });
        });
      }

      // ===== パートナー収益シミュレーション =====
      (function () {
        var PLAN = {
          standard: { name: "スタンダードプラン", monthly: 22 },
          premium: { name: "プレミアムプラン", monthly: 33 },
        };
        var runBtn = document.getElementById("ps-run");
        if (!runBtn) return;
        var last = null;

        var priceInput = document.getElementById("ps-price");
        var priceOut = document.getElementById("ps-price-out");
        priceInput.addEventListener("input", function () {
          priceOut.innerHTML = priceInput.value + "<small>万円</small>";
        });

        function count() {
          var v = parseInt(document.getElementById("ps-count").value, 10);
          return isNaN(v) || v < 0 ? 0 : Math.min(v, 9);
        }
        function plan() {
          var checked = document.querySelector('input[name="ps-plan"]:checked');
          return PLAN[checked ? checked.value : "premium"];
        }

        runBtn.addEventListener("click", function () {
          var price = parseInt(priceInput.value, 10) || 50;
          var n = count();
          var p = plan();
          var sales = price * n;
          var diffM = sales - p.monthly;

          function setNum(id, v) {
            var el = document.getElementById(id);
            if (window.sdCountUp) window.sdCountUp(el, v);
            else el.textContent = v.toLocaleString();
          }
          setNum("ps-sales", sales);
          setNum("ps-sales-y", sales * 12);
          setNum("ps-cost", p.monthly);
          setNum("ps-cost-y", p.monthly * 12);
          document.getElementById("ps-plan-label").textContent = "（" + p.name + "）";

          var diffLabel = document.getElementById("ps-diff-label");
          var comment = document.getElementById("ps-comment");
          setNum("ps-diff", Math.abs(diffM));
          setNum("ps-diff-y", Math.abs(diffM) * 12);
          if (diffM > 0) {
            diffLabel.textContent = "月間の粗利見込み";
            comment.textContent =
              "販売価格も件数も、御社の裁量で伸ばせます。診断レポートを使った販売設計まで含めて、無料相談で具体的にご案内します。";
          } else if (diffM === 0) {
            diffLabel.textContent = "仕入れとの差額";
            comment.textContent =
              "この条件では月商と仕入れが同水準です。販売価格の設定や件数の伸ばし方を、無料相談で一緒に設計します。";
          } else {
            diffLabel.textContent = "仕入れとの差額（不足分）";
            comment.textContent =
              "この件数では仕入れを下回ります。販売が少ない月は一時停止も可能です。無理のない立ち上がり方を無料相談でご提案します。";
          }
          last = { price: price, count: n, plan: p.name, planMonthly: p.monthly, sales: sales, diffM: diffM };
          document.getElementById("ps-result").hidden = false;
          track("lp_partner_sim_run", { event_category: "subsc_partner_funnel", value: diffM });
        });

        document.getElementById("ps-consult").addEventListener("click", function () {
          if (last) {
            var ta = document.querySelector('#lead-form textarea[name="challenges"]');
            if (ta && !ta.value) {
              ta.value =
                "【収益シミュレーション結果】販売価格" + last.price + "万円 × 月" + last.count + "件（" +
                last.plan + "・仕入れ月額" + last.planMonthly + "万円）→ " +
                (last.diffM >= 0
                  ? "月間粗利 約" + last.diffM + "万円（年間約" + last.diffM * 12 + "万円）の試算でした。"
                  : "月間" + Math.abs(last.diffM) + "万円の不足の試算でした。") +
                "パートナー契約について詳しく相談したいです。";
            }
          }
          track("lp_partner_sim_cta", { event_category: "subsc_partner_funnel" });
          var formSec = document.getElementById("contact-form");
          if (formSec) formSec.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      })();

      // スクロール深度（25/50/75/100% を1回ずつ）
      var depths = [25, 50, 75, 100];
      var fired = {};
      function onScroll() {
        var doc = document.documentElement;
        var scrolled = (window.scrollY + window.innerHeight) / doc.scrollHeight * 100;
        depths.forEach(function (d) {
          if (!fired[d] && scrolled >= d) {
            fired[d] = true;
            track("lp_scroll_depth", { event_category: "subsc_partner_funnel", event_label: d + "%", value: d });
          }
        });
        if (fired[100]) window.removeEventListener("scroll", onScroll);
      }
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>

  <script is:inline>
    // ===== モーション層（reduced-motion 尊重） =====
    (function () {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // スクロール連動リビール
      var targets = document.querySelectorAll(
        ".subsc-lp-scope .section-heading, .subsc-lp-scope .check-list li, .subsc-lp-scope .scheme-node, .subsc-lp-scope .scheme-arrow, .subsc-lp-scope .service-terms > div, .subsc-lp-scope .perk-steps li, .subsc-lp-scope .perk-note, .subsc-lp-scope .work-card, .subsc-lp-scope .plan-card, .subsc-lp-scope .slots-banner, .subsc-lp-scope .shindan-panel, .subsc-lp-scope .compare-scroll, .subsc-lp-scope .flow-steps li, .subsc-lp-scope .faq-list details, .subsc-lp-scope .lead-form, .subsc-lp-scope .section-grid > div"
      );
      if (reduce || !("IntersectionObserver" in window)) {
        targets.forEach(function (el) { el.classList.add("rv-in"); });
      } else {
        targets.forEach(function (el, i) {
          el.classList.add("rv");
          el.style.transitionDelay = (i % 4) * 70 + "ms";
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("rv-in");
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
        targets.forEach(function (el) { io.observe(el); });
      }

      // 診断結果のカウントアップ
      window.sdCountUp = function (el, to) {
        if (reduce || to <= 0) { el.textContent = to.toLocaleString(); return; }
        var dur = 500, t0 = null;
        function step(t) {
          if (!t0) t0 = t;
          var p = Math.min((t - t0) / dur, 1);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString();
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      };
    })();
  </script>

  <script>
    // BudouX: 日本語の文節を自動判定して本文を折り返す（両端揃えと併用で右端をそろえる）
    import { loadDefaultJapaneseParser } from "budoux";
    const parser = loadDefaultJapaneseParser();
    const sel = [
      ".subsc-lp-scope .section-lead",
      ".subsc-lp-scope .large-text",
      ".subsc-lp-scope .check-list li",
      ".subsc-lp-scope .scheme-node p",
      ".subsc-lp-scope .perk-steps p",
      ".subsc-lp-scope .perk-note",
      ".subsc-lp-scope .work-body p",
      ".subsc-lp-scope .slots-banner p",
      ".subsc-lp-scope .shindan-note",
      ".subsc-lp-scope .shindan-comment",
      ".subsc-lp-scope .faq-list details p",
      ".subsc-lp-scope .cta-band p",
      ".subsc-lp-scope .contact-form-lead",
      ".subsc-lp-scope .sw-copy__title",
      ".subsc-lp-scope .sw-copy__body",
    ].join(",");
    document.querySelectorAll(sel).forEach((el) => {
      try {
        parser.applyToElement(el);
      } catch (e) {}
    });
  </script>
</BaseLayout>
