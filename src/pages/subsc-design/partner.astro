---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";

const base = import.meta.env.BASE_URL;
// CSSはXserverで1年間キャッシュされるため、内容変更時はバージョンを上げてキャッシュバストする
// styles.css は subsc-design.astro（cssVersion）と共用・無変更。partner側の差分は partner.css / scrub-engine.js / 動画で、
// それぞれ partnerVersion だけをバンプする（本体LPのキャッシュを道連れにしない）
const cssVersion = "20260716-v1"; // src/pages/subsc-design.astro L8 と手動同期
const partnerVersion = "20260720-v1";
const cssHref = `${base}subsc-design/styles.css?v=${cssVersion}`;
const partnerCssHref = `${base}subsc-design/partner.css?v=${partnerVersion}`;
const engineSrc = `${base}subsc-design/partner/scrub-engine.js?v=${partnerVersion}`;
const heroAsset = `${base}subsc-design/partner/assets/`;

const pageUrl = "https://sai-mon.co.jp/subsc-design/partner/";

// 構造化データ: 運営会社・OEMサービス・料金・パンくず・FAQの関係を検索エンジンに伝える
const faqEntity = {
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "顧客にSAIMONの名前は出ますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "出ません。OEM（ホワイトレーベル）方式のため、顧客との契約・請求・納品はすべて御社名義で行えます。SAIMONは制作専門の黒子として御社を支えます。",
      },
    },
    {
      "@type": "Question",
      name: "顧客への販売価格は自由に決められますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "自由です。御社が自社の商品として価格を設定し、月額定額の仕入れとの差額がそのまま御社の粗利になります。",
      },
    },
    {
      "@type": "Question",
      name: "最低契約期間はありますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "最低契約期間は6ヶ月です。経過後は、いつでも翌月での更新停止をお申し出いただけます。",
      },
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sai-mon.co.jp/#organization",
      name: "株式会社SAIMON",
      url: "https://sai-mon.co.jp/",
      logo: "https://sai-mon.co.jp/logo.png",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "SAIMONサブスクデザイン パートナープラン（OEM）",
      serviceType: "採用サイト制作のOEM・ホワイトレーベル提供（月額定額）",
      description:
        "人材紹介会社向けの採用サイト制作OEMサービス。採用サイト・求人LP・採用ピッチ資料の制作を月額定額でSAIMONが巻き取り、パートナーは自社ブランド・自社価格で顧客に販売できます。",
      url: pageUrl,
      provider: { "@id": "https://sai-mon.co.jp/#organization" },
      areaServed: "JP",
      audience: {
        "@type": "Audience",
        audienceType: "人材紹介会社・人材派遣会社・採用支援などのHR事業者",
      },
      offers: [
        {
          "@type": "Offer",
          name: "スタンダードプラン",
          price: "220000",
          priceCurrency: "JPY",
          description: "採用サイト・求人LP・採用販促物のデザイン〜データ納品まで月額定額（納品物は御社名義）",
        },
        {
          "@type": "Offer",
          name: "プレミアムプラン",
          price: "330000",
          priceCurrency: "JPY",
          description: "スタンダードの全内容に加え、コーディング・公開作業・計測タグ設置まで月額定額",
        },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://sai-mon.co.jp/" },
        { "@type": "ListItem", position: 2, name: "サブスクデザイン", item: "https://sai-mon.co.jp/subsc-design/" },
        { "@type": "ListItem", position: 3, name: "パートナープラン", item: pageUrl },
      ],
    },
    faqEntity,
  ],
};
---

<BaseLayout
  title="人材紹介会社向け 採用サイト制作OEM | 自社ブランドで売れる月額定額パートナープラン"
  description="人材紹介事業のもう一つの柱に、採用サイト・求人LP制作を。制作は月額定額でSAIMONが巻き取り、御社は自社ブランド・自社価格で販売。売るほど粗利が増えるOEMパートナープランです。御社名義で使える採用サイト診断レポートの営業ツール付き。パートナー枠は少数限定。"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2033821807210209');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2033821807210209&ev=PageView&noscript=1"/></noscript>
    <!-- End Meta Pixel -->
    <!-- 研修LP向けのFAQ動画チャットボット（BaseLayout共通）はこのLPでは文脈が合わないため非表示 -->
    <style is:global>#faq-chatbot-root { display: none !important; }</style>
    <!-- 見出し用ディスプレイ書体（格式のある明朝） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <link rel="stylesheet" href={cssHref} slot="head" />
  <link rel="stylesheet" href={partnerCssHref} slot="head" />

  <Header />

  <main class="subsc-lp-scope partner-lp">
    <!-- 01 Hero: scroll-world（スクロール連動の夜間都市飛行・2シーン） -->
    <section class="hero-sw" aria-labelledby="hero-title">
      <div id="hero-world">
        <!-- クローラー・JS無効環境向けの静的コピー（エンジンがマウント後に非表示化） -->
        <div data-sw-seo>
          <h1 id="hero-title">人材紹介事業に、もう一つの柱を。</h1>
          <p>
            SAIMONサブスクデザインのパートナープラン（OEM）は、人材紹介会社向けの採用サイト制作サービスです。採用サイト・求人LP・採用ピッチ資料の制作を月額定額でSAIMONが巻き取り、御社は自社ブランド・自社価格で顧客企業に販売できます。売るほど粗利が増える、紹介フィーに次ぐ収益の柱を、御社の手でつくれます。
          </p>
          <h2>御社が売る。制作はSAIMONが。</h2>
          <p>
            顧客との契約・請求・納品はすべて御社名義。SAIMONの名前は出ません。依頼回数・修正は無制限、最低契約6ヶ月、パートナー枠は少数限定です。
          </p>
          <p><a href="#contact-form">無料相談フォームへ</a></p>
        </div>
      </div>
    </section>

    <!-- 制作物マーキー（採用系の対応範囲を視覚化） -->
    <div class="mq" aria-hidden="true">
      <div class="mq-track">
        <span>採用サイト</span><i>◆</i><span>求人LP</span><i>◆</i><span>採用ピッチ資料</span><i>◆</i><span>スカウト用資料</span><i>◆</i><span>求人バナー</span><i>◆</i><span>会社案内</span><i>◆</i><span>社員インタビューページ</span><i>◆</i><span>説明会スライド</span><i>◆</i><span>採用パンフレット</span><i>◆</i><span>SNS採用画像</span><i>◆</i><span>内定者フォロー資料</span><i>◆</i><span>求人原稿デザイン</span><i>◆</i>
        <span>採用サイト</span><i>◆</i><span>求人LP</span><i>◆</i><span>採用ピッチ資料</span><i>◆</i><span>スカウト用資料</span><i>◆</i><span>求人バナー</span><i>◆</i><span>会社案内</span><i>◆</i><span>社員インタビューページ</span><i>◆</i><span>説明会スライド</span><i>◆</i><span>採用パンフレット</span><i>◆</i><span>SNS採用画像</span><i>◆</i><span>内定者フォロー資料</span><i>◆</i><span>求人原稿デザイン</span><i>◆</i>
      </div>
    </div>

    <!-- 02 Problem -->
    <section class="problem section-block" aria-labelledby="problem-title">
      <div class="section-number">02</div>
      <div class="section-grid">
        <div>
          <p class="section-kicker">Problem</p>
          <h2 id="problem-title">
            <span class="no-break">紹介フィー頼みの</span><wbr /><span class="no-break">収益構造に、</span><br /><span class="no-break">こんな不安は</span><wbr /><span class="no-break">ありませんか？</span></h2>
        </div>
        <div>
          <p class="large-text">
            人材紹介は、成約ごとのフィーが収益の柱。ただ、成約が出ない月は売上が立たず、早期退職の返金対応や顧客の採用縮小の影響も<span class="no-break">受けやすい</span>構造です。いっぽうで顧客企業の多くは、求人票の前に<span class="no-break">「採用サイトが古い」</span>という課題を抱えています。ここに応えられれば、紹介の前後に<span class="no-break">継続的な</span>接点と収益が生まれます。</p>
          <ul class="check-list">
            <li>成約フィー頼みで、月ごとの売上の波が大きい</li>
            <li>早期退職の返金・リプレイス対応で、利益が消える月がある</li>
            <li>「応募が来ない」の原因が、求人票ではなく<span class="no-break">採用サイト側</span>にある顧客が多い</li>
            <li>「採用サイトも作れませんか？」と聞かれて、<span class="no-break">断っている</span></li>
            <li>制作会社を紹介しても、自社には<span class="no-break">1円も残らない</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 Scheme（OEMの座組） -->
    <section class="scheme section-block" aria-labelledby="scheme-title">
      <div class="section-number">03</div>
      <div class="section-heading">
        <p class="section-kicker">Scheme</p>
        <h2 id="scheme-title"><span class="no-break">御社が売る。</span><wbr /><span class="no-break">SAIMONが作る。</span><wbr /><span class="no-break">名前は出しません。</span></h2>
        <p class="section-lead">
          OEM（ホワイトレーベル）方式です。顧客との契約・請求・納品はすべて<span class="no-break">御社名義</span>で行い、SAIMONは制作専門の黒子として<span class="no-break">御社の後ろ</span>に立ちます。仕入れは<span class="no-break">月額定額</span>だから、売るほど粗利が増えます。</p>
      </div>
      <div class="scheme-figure" aria-label="OEMの三者関係図">
        <div class="scheme-node scheme-node-client">
          <p class="scheme-node-kicker">顧客企業</p>
          <h3>採用に悩む企業</h3>
          <p>採用サイトの相談は、いつもの担当者＝御社へ。</p>
        </div>
        <div class="scheme-arrow" aria-hidden="true">
          <span>発注・支払い</span>
          <i>⇄</i>
          <span>御社名義で納品</span>
        </div>
        <div class="scheme-node scheme-node-partner">
          <p class="scheme-node-kicker">パートナー（御社）</p>
          <h3>自社ブランド・<wbr />自社価格で販売</h3>
          <p>契約・請求・窓口は御社。販売価格も御社の自由です。</p>
        </div>
        <div class="scheme-arrow" aria-hidden="true">
          <span>制作依頼（月額定額）</span>
          <i>⇄</i>
          <span>制作データ納品</span>
        </div>
        <div class="scheme-node scheme-node-saimon">
          <p class="scheme-node-kicker">SAIMON</p>
          <h3>黒子として制作</h3>
          <p>採用サイト・求人LPを制作。納品物に<span class="no-break">SAIMONの名前</span>は出ません。</p>
        </div>
      </div>
      <dl class="service-terms" aria-label="共通条件">
        <div>
          <dt>依頼回数</dt>
          <dd>無制限</dd>
        </div>
        <div>
          <dt>修正</dt>
          <dd>何度でも</dd>
        </div>
        <div>
          <dt>制作進行</dt>
          <dd>同時1件ずつ</dd>
        </div>
        <div>
          <dt>最低契約</dt>
          <dd>6ヶ月</dd>
        </div>
      </dl>
    </section>

    <!-- 04 収益シミュレーション -->
    <section id="sim" class="shindan section-block" aria-labelledby="sim-title">
      <div class="shindan-panel">
        <div class="section-heading shindan-heading">
          <p class="section-kicker">Simulation</p>
          <h2 id="sim-title"><span class="no-break">30秒でわかる、</span><wbr /><span class="no-break">パートナー収益</span><wbr /><span class="no-break">シミュレーション</span></h2>
          <p class="section-lead"><span class="no-break">御社の販売価格と</span><wbr /><span class="no-break">月間の販売件数を</span><wbr /><span class="no-break">動かすだけで、</span><wbr /><span class="no-break">月間・年間の粗利を</span><wbr /><span class="no-break">その場で試算できます。</span></p>
        </div>
        <div class="shindan-form sim-form" role="group" aria-label="販売条件の入力">
          <label class="shindan-field sim-field-slider">
            <span>採用サイト1件の販売価格<em>万円</em></span>
            <div class="sim-slider-row">
              <input type="range" id="ps-price" min="30" max="80" step="5" value="50" />
              <output id="ps-price-out" for="ps-price">50<small>万円</small></output>
            </div>
          </label>
          <label class="shindan-field">
            <span>月間の販売件数<em>件/月</em></span>
            <input type="number" id="ps-count" min="0" max="9" value="2" inputmode="numeric" />
          </label>
          <fieldset class="sim-plan-choice">
            <legend>仕入れプラン</legend>
            <label><input type="radio" name="ps-plan" value="standard" /><span>スタンダード 22万<small>デザイン納品まで</small></span></label>
            <label><input type="radio" name="ps-plan" value="premium" checked /><span>プレミアム 33万<small>実装・公開まで</small></span></label>
          </fieldset>
          <button type="button" id="ps-run" class="primary-cta shindan-run">試算する<span aria-hidden="true">→</span></button>
        </div>
        <div id="ps-result" class="shindan-result" hidden>
          <div class="shindan-cards">
            <div class="shindan-card">
              <p class="shindan-card-label">御社の月商（制作分）</p>
              <p class="shindan-card-value">月<strong id="ps-sales">0</strong>万円</p>
              <p class="shindan-sub">年間 <span id="ps-sales-y">0</span>万円</p>
            </div>
            <div class="shindan-card">
              <p class="shindan-card-label">仕入れ（SAIMON月額）</p>
              <p class="shindan-card-value">月<strong id="ps-cost">0</strong>万円</p>
              <p class="shindan-sub">年間 <span id="ps-cost-y">0</span>万円<span id="ps-plan-label" class="shindan-plan"></span></p>
            </div>
            <div class="shindan-card shindan-card-diff">
              <p class="shindan-card-label" id="ps-diff-label">月間の粗利見込み</p>
              <p class="shindan-card-value">月<strong id="ps-diff">0</strong>万円</p>
              <p class="shindan-sub">年間 <span id="ps-diff-y">0</span>万円</p>
            </div>
          </div>
          <p id="ps-comment" class="shindan-comment"></p>
          <div class="shindan-cta">
            <button type="button" id="ps-consult" class="primary-cta">この試算をもとに無料相談する<span aria-hidden="true">→</span></button>
          </div>
          <p class="shindan-note">
            ※販売価格・件数は御社が自由に設定できる想定値です。制作は同時進行1件ずつのため、納期は内容・分量により変動します。試算は概算であり、成果を保証するものではありません。</p>
        </div>
      </div>
    </section>

    <!-- 05 営業ツール特典（採用サイト診断レポート） -->
    <section class="perk section-block" aria-labelledby="perk-title">
      <div class="section-number">05</div>
      <div class="section-heading">
        <p class="section-kicker">Sales Kit</p>
        <h2 id="perk-title"><span class="no-break">営業フックは、</span><wbr /><span class="no-break">こちらで用意しました。</span></h2>
        <p class="section-lead">
          「何を持って営業すればいいのか」から<span class="no-break">悩ませません。</span>見込み顧客の採用サイトを分析した<span class="no-break">改善提案レポート</span>（15ページ）を、<span class="no-break">御社名義</span>で作成します。渡すだけで課題が可視化され、制作の商談が<span class="no-break">自然に始まります。</span></p>
      </div>
      <ol class="perk-steps">
        <li>
          <span class="perk-num">01</span>
          <h3>対象企業のURLを送るだけ</h3>
          <p>見込み顧客の採用サイトURLを、専用チャットに送ります。</p>
        </li>
        <li>
          <span class="perk-num">02</span>
          <h3>御社名義のレポートが届く</h3>
          <p>候補者視点・スマホ閲覧・競合比較の観点で分析した15ページのレポート（PDF）を、御社ブランドで仕上げます。</p>
        </li>
        <li>
          <span class="perk-num">03</span>
          <h3>渡して、商談する</h3>
          <p>課題が具体的に見えるので、「では作り直しましょう」の提案が通りやすくなります。</p>
        </li>
      </ol>
      <p class="perk-note">※レポート作成もパートナー契約の月額内です（通常の制作枠で、1件ずつ対応します）。</p>
    </section>

    <!-- 06 Case（NASH実績） -->
    <section class="works section-block" aria-labelledby="case-title">
      <div class="section-number">06</div>
      <div class="section-heading">
        <p class="section-kicker">Case</p>
        <h2 id="case-title"><span class="no-break">SAIMONが支援した採用サイトは、</span><wbr /><span class="no-break">応募数137%に。</span></h2>
      </div>
      <article class="work-card partner-case-card">
        <figure class="work-media"><img src={`${base}case-site-image.jpg`} alt="株式会社NASHの採用サイト" loading="lazy" width="1200" height="675" /></figure>
        <div class="work-body">
          <p class="work-tag">採用サイトリニューアル</p>
          <h3>株式会社NASH様</h3>
          <ul class="case-kpis" aria-label="リニューアル後の主な成果">
            <li><strong>137%</strong><span>応募数（前年比）</span></li>
            <li><strong>即日</strong><span>公開後の更新対応</span></li>
          </ul>
          <p>株式会社NASH様の採用サイトは、SAIMONの研修・伴走支援を通じてリニューアルされ、公開後の応募数は前年比137%に伸びました。パートナー契約では、この支援で培った「応募につながる採用サイトの型」を使って、SAIMONが御社ブランドの納品物を制作します。</p>
          <a class="case-link" href="https://recruit.nash-holdings.com" target="_blank" rel="noopener">公開サイトを見る<span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </section>

    <!-- 07 Price -->
    <section id="price" class="price section-block" aria-labelledby="price-title">
      <div class="section-number">07</div>
      <div class="section-heading">
        <p class="section-kicker">Price</p>
        <h2 id="price-title">パートナー料金プラン</h2>
        <p class="section-lead">
