---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";

const base = import.meta.env.BASE_URL;
// CSSはXserverで1年間キャッシュされるため、内容変更時はバージョンを上げてキャッシュバストする
const cssVersion = "20260714-v4";
const cssHref = `${base}subsc-design/styles.css?v=${cssVersion}`;

const pageUrl = "https://sai-mon.co.jp/subsc-design/";

// 構造化データ: 運営会社・サービス・料金・パンくず・FAQの関係を検索エンジンに伝える
const faqEntity = {
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "「作り放題」に上限はありますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "依頼回数・修正回数に上限はありません。ただし制作は同時進行1件ずつで、いただいた依頼リストの上から順にお届けします。",
      },
    },
    {
      "@type": "Question",
      name: "複数社でのシェア利用はできますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "できます。1つの契約を複数の会社・個人事業主で共有し、共通チャットから各社が依頼できます。費用の分担方法は自由です。",
      },
    },
    {
      "@type": "Question",
      name: "契約を一時停止できますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "可能です。依頼が少ない月は一時停止し、残りの契約期間を持ち越せます。",
      },
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sai-mon.co.jp/#organization",
      name: "株式会社SAIMON",
      url: "https://sai-mon.co.jp/",
      logo: "https://sai-mon.co.jp/logo.png",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "SAIMONサブスクデザイン",
      serviceType: "月額定額デザイン制作（デザインのサブスクリプション）",
      description:
        "保険・互助会業界に特化した月額定額のデザイン制作サービス。バナー・チラシ・営業資料からLP・Webサイトまで、専属デザイナーに定額で何度でも依頼できます。",
      url: pageUrl,
      provider: { "@id": "https://sai-mon.co.jp/#organization" },
      areaServed: "JP",
      audience: {
        "@type": "Audience",
        audienceType: "保険会社・少額短期保険・冠婚葬祭互助会・代理店・個人事業主",
      },
      offers: [
        {
          "@type": "Offer",
          name: "ライトプラン",
          price: "110000",
          priceCurrency: "JPY",
          description: "バナー・SNS画像・チラシ・営業資料が月額定額で依頼し放題（LP・Webサイトを除く）",
        },
        {
          "@type": "Offer",
          name: "スタンダードプラン",
          price: "220000",
          priceCurrency: "JPY",
          description: "ライトの全内容に加え、LP・Webサイトのデザインからデータ納品まで月額定額",
        },
        {
          "@type": "Offer",
          name: "プレミアムプラン",
          price: "330000",
          priceCurrency: "JPY",
          description: "スタンダードの全内容に加え、コーディング・公開作業・計測タグ設置まで月額定額",
        },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://sai-mon.co.jp/" },
        { "@type": "ListItem", position: 2, name: "サブスクデザイン", item: pageUrl },
      ],
    },
    faqEntity,
  ],
};
---

<BaseLayout
  title="保険・互助会特化のデザインサブスク | 月額定額デザイン制作"
  description="保険・互助会業界特化の月額定額デザイン制作サブスク「SAIMONサブスクデザイン」。バナー・チラシ・LP・Webサイトを業界経験のある専属デザイナーに定額で何度でも依頼できます。バナー2営業日・LP3営業日目安、同時受入10社限定・複数社シェアOK。"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2033821807210209');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2033821807210209&ev=PageView&noscript=1"/></noscript>
    <!-- End Meta Pixel -->
    <!-- 研修LP向けのFAQ動画チャットボット（BaseLayout共通）はこのLPでは文脈が合わないため非表示 -->
    <style is:global>#faq-chatbot-root { display: none !important; }</style>
    <!-- 見出し用ディスプレイ書体（格式のある明朝） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <link rel="stylesheet" href={cssHref} slot="head" />

  <Header />

  <main class="subsc-lp-scope">
    <!-- 01 Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-ambient" aria-hidden="true">
        <i class="orb orb-a"></i>
        <i class="orb orb-b"></i>
      </div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">SAIMON サブスクデザイン</p>
          <p class="industry-badge"><strong>保険・互助会業界</strong><span>特化</span></p>
          <h1 id="hero-title">
            月額定額、<span class="hero-highlight">作り放題</span>の<br />
            専属デザイナー。</h1>
          <p class="hero-lead">
            バナー・チラシからLP・Webサイトまで、月額定額で何度でも依頼できるサブスク型のデザイン制作サービスです。<strong class="lead-em">保険・互助会業界</strong>での勤務経験と制作実績を持つデザイナーが、御社専属で対応します。</p>
          <div class="hero-pain-quotes" aria-label="デザイン外注で起きがちな悩み">
            <span>バナー1枚でも、また見積もりと発注書…</span>
            <span>業界の表現ルールを毎回イチから説明</span>
            <span>LPとチラシで外注先がバラバラ</span>
            <span>仕上がりの品質が担当者しだい</span>
          </div>
          <div class="slots-banner" aria-label="同時受入の上限">
            <span class="slots-dot" aria-hidden="true"></span>
            <p>専属品質を保つため、同時受入は<strong>10社限定</strong>です。空き枠は無料相談時にご案内します。</p>
          </div>
          <div class="hero-actions">
            <a class="primary-cta" href="#contact-form" data-cta-source="hero-primary">
              空き枠を確認して無料相談する<span aria-hidden="true">→</span>
            </a>
            <p class="hero-cta-note">相談無料・しつこい営業なし／オンライン対応／1営業日以内に返信</p>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="chat-mock">
            <div class="chat-mock-head">
              <i></i>
              <span>専用チャット — SAIMONサブスクデザイン</span>
            </div>
            <div class="chat-mock-body">
              <div class="chat-msg chat-msg-client">
                <em>御社</em>
                <p>来月のキャンペーンLPと、告知バナーを3種お願いします</p>
              </div>
              <div class="chat-msg chat-msg-designer">
                <em>専属デザイナー</em>
                <p>承知しました。まずバナー3種を今週中に、LPは来週初稿をお送りします</p>
              </div>
              <div class="chat-msg chat-msg-deliver">
                <span>納品</span>
                <p>banner_A.png / banner_B.png / banner_C.png</p>
              </div>
              <div class="chat-msg chat-msg-client">
                <em>御社</em>
                <p>早い…！Bのコピーだけ、少し柔らかい言い回しにできますか？</p>
              </div>
              <div class="chat-msg chat-msg-designer">
                <em>専属デザイナー</em>
                <p>修正しました。気になる点があれば何度でもどうぞ</p>
              </div>
              <div class="chat-msg chat-msg-deliver">
                <span>納品</span>
                <p>banner_B_v2.png</p>
              </div>
              <div class="chat-msg chat-msg-client">
                <em>御社</em>
                <p>完璧です！では次はチラシの改訂をお願いします</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <dl class="hero-metrics" aria-label="サービス概要">
        <div>
          <dt>月額</dt>
          <dd><strong>11万円〜</strong><br />（税込）</dd>
        </div>
        <div>
          <dt>依頼回数</dt>
          <dd><strong>無制限</strong></dd>
        </div>
        <div>
          <dt>修正</dt>
          <dd><strong>何度でも</strong></dd>
        </div>
        <div>
          <dt>シェア利用</dt>
          <dd><strong>複数社OK</strong></dd>
        </div>
      </dl>
    </section>

    <!-- 制作物マーキー（作り放題の視覚化） -->
    <div class="mq" aria-hidden="true">
      <div class="mq-track">
        <span>バナー</span><i>◆</i><span>チラシ</span><i>◆</i><span>パンフレット</span><i>◆</i><span>LP</span><i>◆</i><span>Webサイト</span><i>◆</i><span>SNS画像</span><i>◆</i><span>営業資料</span><i>◆</i><span>ポスター</span><i>◆</i><span>DM・はがき</span><i>◆</i><span>会報誌</span><i>◆</i><span>のぼり</span><i>◆</i><span>名刺・封筒</span><i>◆</i>
        <span>バナー</span><i>◆</i><span>チラシ</span><i>◆</i><span>パンフレット</span><i>◆</i><span>LP</span><i>◆</i><span>Webサイト</span><i>◆</i><span>SNS画像</span><i>◆</i><span>営業資料</span><i>◆</i><span>ポスター</span><i>◆</i><span>DM・はがき</span><i>◆</i><span>会報誌</span><i>◆</i><span>のぼり</span><i>◆</i><span>名刺・封筒</span><i>◆</i>
      </div>
    </div>

    <!-- 02 Problem -->
    <section class="problem section-block" aria-labelledby="problem-title">
      <div class="section-number">02</div>
      <div class="section-grid">
        <div>
          <p class="section-kicker">Problem</p>
          <h2 id="problem-title">
            デザインを頼むたびに、<br />こんな手間が発生していませんか？</h2>
        </div>
        <div>
          <p class="large-text">
            単発の外注は、依頼のたびに「探す・説明する・見積もる・検収する」のコストがかかります。とくに保険・互助会の販促物は、商品理解や表現の配慮が欠かせないため、外注先への説明だけでひと仕事になりがちです。</p>
          <ul class="check-list">
            <li>バナー1枚でも、見積もり・発注書・請求書のやりとりが発生する</li>
            <li>保険・互助会特有の表現ルールを、毎回イチから説明している</li>
            <li>制作会社は高く、クラウドソーシングは品質と管理が不安</li>
            <li>LP・チラシ・SNS画像で外注先を使い分けていて、管理が大変</li>
            <li>キャンペーンの立ち上げに、制作が間に合わない</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 Service -->
    <section class="service section-block" aria-labelledby="service-title">
      <div class="section-number">03</div>
      <div class="section-heading">
        <p class="section-kicker">Service</p>
        <h2 id="service-title">月額定額で「頼んで、受け取って、<span class="no-break">また頼む」だけ。</span></h2>
        <p class="section-lead">
          ご契約後は、専用チャットに依頼を送るだけ。見積もりも発注書も、もう必要ありません。制作は同時進行1件ずつ、依頼リストの上から順に丁寧にお届けします。</p>
      </div>
      <ol class="loop-visual" aria-label="依頼から納品までのループ">
        <li>
          <span class="loop-step">1</span>
          <h3>依頼を送る</h3>
          <p>チャットに要望を書くだけ。丸投げでもOK。</p>
        </li>
        <li>
          <span class="loop-step">2</span>
          <h3>制作</h3>
          <p>業界経験のある専属デザイナーがスピーディーに制作。</p>
        </li>
        <li>
          <span class="loop-step">3</span>
          <h3>納品・修正</h3>
          <p>確認して修正依頼。修正回数は無制限。</p>
        </li>
        <li class="loop-return">
          <span class="loop-step">↻</span>
          <h3>次の依頼へ</h3>
          <p>完了したら、そのまま次の制作に着手します。</p>
        </li>
      </ol>
      <dl class="service-terms" aria-label="共通条件">
        <div>
          <dt>依頼回数</dt>
          <dd>無制限</dd>
        </div>
        <div>
          <dt>修正</dt>
          <dd>何度でも</dd>
        </div>
        <div>
          <dt>一時停止</dt>
          <dd>OK</dd>
        </div>
        <div>
          <dt>最低契約</dt>
          <dd>6ヶ月</dd>
        </div>
      </dl>
    </section>

    <!-- 04 Reasons -->
    <section class="reasons section-block" aria-labelledby="reasons-title">
      <div class="section-number">04</div>
      <div class="section-heading">
        <p class="section-kicker">Why SAIMON</p>
        <h2 id="reasons-title">選ばれる理由</h2>
      </div>
      <div class="reason-grid">
        <article class="reason-card" data-index="01">
          <h3>保険業界の<span class="no-break">「中の人」</span>だった経験</h3>
          <p>
            代表デザイナーは、保険業界でWEBマーケティング担当として勤務した経歴を持ちます。商品特性・訴求の勘所・表現の配慮を理解しているため、業界説明のコストがかかりません。</p>
          <em>説明いらずの業界理解</em>
        </article>
        <article class="reason-card" data-index="02">
          <h3>互助会・保険業界での制作実績</h3>
          <p>
            大手互助会グループのキャンペーンLPや、葬儀保険のLPなど、業界案件の制作・公開実績があります。実物は無料相談時にご覧いただけます。</p>
          <em>業界案件の実績多数</em>
        </article>
        <article class="reason-card" data-index="03">
          <h3>制作フローの効率化による<span class="no-break">圧倒的スピード</span></h3>
          <p>
            ヒアリングから制作・納品までのフローを徹底的に効率化。品質を保ちながら、バナーは2営業日、LPは3営業日を目安にお届けします。</p>
          <em>速さと品質の両立</em>
        </article>
        <article class="reason-card" data-index="04">
          <h3>デザインから実装・公開まで一気通貫</h3>
          <p>
            デザインデータを渡して終わり、ではありません。プレミアムプランでは、コーディングから公開作業、計測タグの設置まで一貫して担当します。</p>
          <em>「公開まで」を任せられる</em>
        </article>
      </div>
    </section>

    <!-- 05 Works -->
    <section class="works section-block" aria-labelledby="works-title">
      <div class="section-number">05</div>
      <div class="section-heading">
        <p class="section-kicker">Works</p>
        <h2 id="works-title">制作実績</h2>
        <p class="section-lead">
          保険・互助会業界を中心に、LP・バナー・営業資料まで幅広く手がけています。その品質を、月額定額で何度でも。</p>
      </div>
      <div class="works-grid">
        <article class="work-card">
          <figure class="work-media"><img src={`${base}subsc-design/assets/work-wedding.jpg`} alt="温かな光に包まれた結婚式場のイメージ" loading="lazy" width="900" height="599" /></figure>
          <div class="work-body">
            <p class="work-tag">結婚式場LP</p>
            <h3>大手冠婚葬祭グループ様</h3>
            <p>グループが運営する結婚式場のLPを制作。会場の魅力が伝わる写真の見せ方と、お問い合わせにつながる構成を意識して仕上げました。</p>
          </div>
        </article>
        <article class="work-card">
          <figure class="work-media"><img src={`${base}subsc-design/assets/work-flower.jpg`} alt="白い菊とユリの上品なアレンジメントのイメージ" loading="lazy" width="900" height="599" /></figure>
          <div class="work-body">
            <p class="work-tag">葬儀保険LP</p>
            <h3>少額短期保険様</h3>
            <p>葬儀保険の商品LPを制作。保険商品ならではの表現の配慮を踏まえながら、お客様に安心感が伝わる誠実なトーンでまとめました。</p>
          </div>
        </article>
        <article class="work-card">
          <figure class="work-media"><img src={`${base}subsc-design/assets/work-event.jpg`} alt="ネイビーと金の招待状・ギフトのイメージ" loading="lazy" width="900" height="599" /></figure>
          <div class="work-body">
            <p class="work-tag">イベントチラシ</p>
            <h3>互助会代理店様</h3>
            <p>会員様向けイベントの告知チラシを制作。日時や特典などの情報を整理し、ひと目で内容が伝わる紙面構成に仕上げました。</p>
          </div>
        </article>
      </div>
      <p class="works-note">
        ※写真は世界観のイメージです。実績の社名・制作物の実物は、掲載許可が取れたものから順次公開します（無料相談ではすべてご覧いただけます）。</p>
    </section>

    <!-- コスト診断（リードマグネット） -->
    <section id="shindan" class="shindan section-block" aria-labelledby="shindan-title">
      <div class="shindan-panel">
        <div class="section-heading shindan-heading">
          <p class="section-kicker">Simulation</p>
          <h2 id="shindan-title">30秒でわかる、デザイン外注費かんたん診断</h2>
          <p class="section-lead">
            制作本数を入れるだけで、年間の外注費とサブスク切替時の差額をその場で試算できます。</p>
        </div>
        <div class="shindan-form" role="group" aria-label="制作本数の入力">
          <label class="shindan-field">
            <span>バナー・SNS画像<em>本/月</em></span>
            <input type="number" id="sd-banner" min="0" max="99" value="0" inputmode="numeric" />
          </label>
          <label class="shindan-field">
            <span>チラシ・パンフレット・営業資料<em>本/月</em></span>
            <input type="number" id="sd-flyer" min="0" max="99" value="0" inputmode="numeric" />
          </label>
          <label class="shindan-field">
            <span>LP・Webサイト<em>本/月</em></span>
            <input type="number" id="sd-lp" min="0" max="99" value="0" inputmode="numeric" />
          </label>
          <button type="button" id="sd-run" class="primary-cta shindan-run">診断する<span aria-hidden="true">→</span></button>
        </div>
        <div id="sd-result" class="shindan-result" hidden>
          <div class="shindan-cards">
            <div class="shindan-card">
              <p class="shindan-card-label">現在の外注費（概算）</p>
              <p class="shindan-card-value">月<strong id="sd-current">0</strong>万円</p>
              <p class="shindan-sub">年間 <span id="sd-current-y">0</span>万円</p>
            </div>
            <div class="shindan-card">
              <p class="shindan-card-label">サブスクに切り替えると</p>
              <p class="shindan-card-value">月<strong id="sd-subsc">0</strong>万円</p>
              <p class="shindan-sub">年間 <span id="sd-subsc-y">0</span>万円<span id="sd-plan" class="shindan-plan"></span></p>
            </div>
            <div class="shindan-card shindan-card-diff">
              <p class="shindan-card-label" id="sd-diff-label">削減見込み</p>
