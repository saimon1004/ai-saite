---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";

const base = import.meta.env.BASE_URL;
// CSSはXserverで1年間キャッシュされるため、内容変更時はバージョンを上げてキャッシュバストする。
// styles.css は partner LP と共用のため、本体は専用の lp.css を読む（2026-09-29 汎用リニューアル）
const cssVersion = "20260929-v7";
const cssHref = `${base}subsc-design/lp.css?v=${cssVersion}`;
const asset = (f: string) => `${base}subsc-design/assets/${f}`;

const pageUrl = "https://sai-mon.co.jp/subsc-design/";

// lucide アイコン（ISC License）のパスをそのまま埋め込む
const icon = {
  pointer: '<path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"/>',
  square: '<rect width="18" height="18" x="3" y="3" rx="2"/>',
  image: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  type: '<polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/>',
  droplet: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  layers: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};
const svg = (name: keyof typeof icon, cls = "ic") =>
  `<svg class="${cls}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;

// ヒーローの作品壁（実物＋サンプル作品。サンプルは生成写真に日本語コピーをHTMLで組んだもの）
type WallCard = { k: "poster" | "web" | "img" | "video"; t?: string; img?: string; src?: string; poster?: string; ar: string; s?: number };
const wallCards: WallCard[] = [
  { k: "poster", t: "fashion", img: "fashion.jpg", ar: "2 / 3" },
  { k: "video", src: "nature.mp4", poster: "nature-poster.jpg", ar: "9 / 16" },
  { k: "poster", t: "runner", img: "runner.jpg", ar: "2 / 3" },
  { k: "img", img: "lp-insta.jpg", ar: "16 / 10", s: 0.68 },
  { k: "poster", t: "lemon", img: "lemon.jpg", ar: "2 / 3" },
  { k: "web", t: "coffee", img: "coffee.jpg", ar: "4 / 5" },
  { k: "video", src: "omakase.mp4", poster: "omakase-poster.jpg", ar: "16 / 9", s: 0.66 },
  { k: "poster", t: "architecture", img: "architecture.jpg", ar: "2 / 3" },
  { k: "poster", t: "skincare", img: "skincare.jpg", ar: "2 / 3" },
];
const hero = (f: string) => `${base}subsc-design/assets/hero/${f}`;
const backThumbs = ["fashion.jpg", "nature-poster.jpg", "lemon.jpg", "lp-insta.jpg", "architecture.jpg", "coffee.jpg", "runner.jpg", "omakase-poster.jpg", "skincare.jpg"];

const deliverables = ["バナー", "チラシ", "パンフレット", "LP", "Webサイト", "SNS画像", "営業資料", "ポスター", "DM・はがき", "メルマガ画像", "展示会パネル", "名刺・封筒"];

// 構造化データ: 運営会社・サービス・料金・パンくず・FAQの関係を検索エンジンに伝える
const faqEntity = {
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "「作り放題」に上限はありますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "依頼回数・修正回数に上限はありません。ただし制作は同時進行1件ずつで、いただいた依頼リストの上から順にお届けします。",
      },
    },
    {
      "@type": "Question",
      name: "納期の目安はどれくらいですか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "バナー等は2営業日、LPは3営業日が目安です（内容・分量・依頼の順番により変動します）。",
      },
    },
    {
      "@type": "Question",
      name: "複数社でのシェア利用はできますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "できます。1つの契約を複数の会社・個人事業主で共有し、共通チャットから各社が依頼できます。費用の分担方法は自由です。",
      },
    },
    {
      "@type": "Question",
      name: "契約を一時停止できますか？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "可能です。依頼が少ない月は一時停止し、残りの契約期間を持ち越せます。",
      },
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sai-mon.co.jp/#organization",
      name: "株式会社SAIMON",
      url: "https://sai-mon.co.jp/",
      logo: "https://sai-mon.co.jp/logo.png",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "SAIMONサブスクデザイン",
      serviceType: "月額定額デザイン制作（デザインのサブスクリプション）",
      description:
        "月額定額のデザイン制作サービス。バナー・チラシ・営業資料からLP・Webサイトまで、専属デザイナーに定額で何度でも依頼できます。バナー2営業日・LP3営業日目安。",
      url: pageUrl,
      provider: { "@id": "https://sai-mon.co.jp/#organization" },
      areaServed: "JP",
      audience: {
        "@type": "Audience",
        audienceType: "中小企業・スタートアップ・店舗・マーケティング担当者・個人事業主",
      },
      offers: [
        {
          "@type": "Offer",
          name: "ライトプラン",
          price: "110000",
          priceCurrency: "JPY",
          description: "バナー・SNS画像・チラシ・営業資料が月額定額で作り放題（LP・Webサイトを除く）",
        },
        {
          "@type": "Offer",
          name: "スタンダードプラン",
          price: "220000",
          priceCurrency: "JPY",
          description: "ライトの全内容に加え、LP・Webサイトのデザインからデータ納品まで月額定額で作り放題",
        },
        {
          "@type": "Offer",
          name: "プレミアムプラン",
          price: "330000",
          priceCurrency: "JPY",
          description: "スタンダードの全内容に加え、コーディング・公開作業・計測タグ設置まで月額定額で作り放題",
        },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://sai-mon.co.jp/" },
        { "@type": "ListItem", position: 2, name: "サブスクデザイン", item: pageUrl },
      ],
    },
    faqEntity,
  ],
};
---

<BaseLayout
  title="デザインのサブスク | 月額定額・作り放題のデザイン制作 | SAIMONサブスクデザイン"
  description="月額定額で作り放題のデザインサブスク「SAIMONサブスクデザイン」。バナー・チラシ・LP・Webサイトを専属デザイナーに何度でも依頼できます。バナー2営業日・LP3営業日目安、見積もり・発注書は不要。同時受入10社限定・複数社シェアOK。"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2033821807210209');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2033821807210209&ev=PageView&noscript=1"/></noscript>
    <!-- End Meta Pixel -->
    <!-- 研修LP向けのFAQ動画チャットボット（BaseLayout共通）はこのLPでは文脈が合わないため非表示 -->
    <style is:global>#faq-chatbot-root { display: none !important; }</style>
    <!-- 見出し（和文ゴシック）と数字・欧文ラベル -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <link rel="stylesheet" href={cssHref} slot="head" />

  <Header />

  <main class="sd-scope">
    <!-- 01 Hero（ダーク。作品が弧状の壁を流れながら次々と組み上がる） -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-head">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>SAIMON サブスクデザイン</p>
        <h1 id="hero-title"><span class="no-break"><span class="hl">速い。</span>作り放題。</span><span class="h1-sub"><span class="no-break">月額定額の</span><wbr /><span class="no-break">専属デザイナー。</span></span></h1>
        <div class="hero-row">
          <dl class="speed-chips" aria-label="納期の目安">
            <div><dt>バナー</dt><dd><strong>2</strong>営業日<small>目安</small></dd></div>
            <div><dt>LP</dt><dd><strong>3</strong>営業日<small>目安</small></dd></div>
            <div><dt>見積もり</dt><dd><strong>0</strong>回</dd></div>
          </dl>
          <a class="primary-cta" href="#contact-form" data-cta-source="hero-primary">無料で相談してみる<Fragment set:html={svg("arrow")} /></a>
        </div>
        <ul class="hero-facts" aria-label="サービス概要">
          <li>月額<strong>11万円〜</strong>（税込）</li>
          <li>依頼・修正<strong>無制限</strong></li>
          <li><strong>複数社</strong>でシェアOK</li>
          <li class="hero-facts-slots"><span class="slots-dot" aria-hidden="true"></span>同時受入<strong>10社限定</strong></li>
        </ul>
      </div>

      <div class="wall" aria-hidden="true">
        <div class="wall-back">
          {[0, 1].map((row) => (
            <div class={`wall-back-row wall-back-row-${row}`}>
              {[0, 1].map(() => (row ? backThumbs.slice().reverse() : backThumbs).map((f) => <img src={hero(f)} alt="" loading="lazy" decoding="async" width="160" height="200" />))}
            </div>
          ))}
        </div>
        <div class="wall-streaks"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="wall-stage" id="wall">
          {wallCards.map((c) => (
            <div class={`wc wc-${c.k}${c.t ? ` wc-${c.t}` : ""}`} style={`--ar:${c.ar};--s:${c.s ?? 1}`}>
              <div class="wc-draft"><i></i><i></i><i></i><i></i></div>
              <div class="wc-body">
                {c.k === "img" && <img src={hero(c.img!)} alt="" decoding="async" width="560" height="700" />}
                {c.k === "video" && <video src={hero(c.src!)} poster={hero(c.poster!)} muted loop playsinline preload="none"></video>}
                {c.k === "poster" && <img class="wc-photo" src={hero(c.img!)} alt="" decoding="async" width="640" height="960" />}
                {c.t === "fashion" && <div class="wc-copy"><b class="f-mark">ROUGE</b><p class="f-jp">美しさは、<br />生き方から。</p><small class="f-foot">FASHION / LIFESTYLE</small></div>}
                {c.t === "runner" && <div class="wc-copy"><small class="r-brand">KAZE</small><p class="r-jp">動き出す。<br />もっと遠くへ。</p><b class="r-en">RUN<br />THE NEXT</b></div>}
                {c.t === "lemon" && <div class="wc-copy"><small class="l-brand">SUNNY LEMON</small><p class="l-jp">ひとくちで、<br />気分が晴れる。</p><em class="l-script">Good mood, every day</em></div>}
                {c.t === "architecture" && <div class="wc-copy"><small class="a-brand">NORTH ATELIER</small><div class="a-panel"><p class="a-jp">建てることは、<br />未来をつくること。</p><small>ARCHITECTURE FOR TOMORROW</small></div></div>}
                {c.t === "skincare" && <div class="wc-copy"><small class="s-brand">SORA SKIN</small><p class="s-jp">肌に、<br />静かな余白を。</p><small class="s-foot">Moist Serum 30ml</small></div>}
                {c.t === "coffee" && (
                  <div class="wc-web">
                    <div class="w-nav"><b>TOMOSHIBI</b><i></i><i></i><i></i></div>
                    <div class="w-main">
                      <div class="w-copy"><p>日常を、<br />少し特別に。</p><span>コーヒーのある景色</span><em>VIEW MORE</em></div>
                      <img src={hero(c.img!)} alt="" decoding="async" width="640" height="960" />
                    </div>
                    <div class="w-thumbs"><i></i><i></i><i></i></div>
                  </div>
                )}
              </div>
              <span class="wc-sel"><i></i><i></i><i></i><i></i></span>
              <span class="wc-done" set:html={`${svg("check", "ic ic-sm")}納品`} />
            </div>
          ))}
        </div>
        <p class="wall-note">※一部、制作イメージのサンプル作品を含みます</p>
      </div>

    </section>

    <!-- 制作物マーキー（作り放題の視覚化・2段逆走） -->
    <div class="mq" aria-hidden="true">
      <div class="mq-track">
        {[0, 1].map(() => deliverables.map((d) => <><span>{d}</span><i></i></>))}
      </div>
      <div class="mq-track mq-reverse">
        {[0, 1].map(() => deliverables.slice().reverse().map((d) => <><span>{d}</span><i></i></>))}
      </div>
    </div>

    <!-- 02 Problem -->
    <section class="problem section-block" aria-labelledby="problem-title">
      <div class="section-grid">
        <div class="section-heading">
          <p class="section-kicker">Problem</p>
          <h2 id="problem-title"><span class="no-break">デザインを頼むたびに、</span><wbr /><span class="no-break">こんな手間が</span><wbr /><span class="no-break">発生していませんか？</span></h2>
        </div>
        <div>
          <p class="large-text">単発の外注は、依頼のたびに「探す・説明する・<span class="no-break">見積もる</span>・<span class="no-break">検収する</span>」のコストがかかります。社内にデザイナーがいない会社ほど、外注先とのやりとりと進行管理だけで<span class="no-break">ひと仕事</span>になりがちです。</p>
          <ul class="check-list">
            <li>バナー1枚でも、見積もり・発注書・請求書のやりとりが発生する</li>
            <li>商品やブランドのトーンを、毎回<span class="no-break">イチから</span>説明している</li>
            <li>制作会社は高く、クラウドソーシングは<span class="no-break">品質と管理</span>が不安</li>
            <li>LP・チラシ・SNS画像で外注先を<span class="no-break">使い分けて</span>いて、管理が大変</li>
            <li>キャンペーンの立ち上げに、制作が<span class="no-break">間に合わない</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 Speed（新設: 納品までの日数レース） -->
    <section id="speed" class="speed" aria-labelledby="speed-title">
      <div class="section-block">
        <div class="section-heading section-heading-center">
          <p class="section-kicker">Speed</p>
          <h2 id="speed-title"><span class="no-break">見積もりを待つ間に、</span><wbr /><span class="no-break">もう届く。</span></h2>
          <p class="section-lead">都度外注では、制作が始まる前に「探す・見積もる・<span class="no-break">発注する</span>」が挟まります。サブスクなら、チャットで依頼した時点で<span class="no-break">制作の順番</span>に入ります。</p>
        </div>

        <div class="race" id="race">
          <div class="race-head">
            <p class="race-clock">経過 <strong id="race-day">0</strong> 営業日</p>
            <ol class="race-scale" aria-hidden="true">
              {Array.from({ length: 15 }, (_, i) => <li>{i + 1}</li>)}
            </ol>
          </div>

          <div class="race-row race-row-other" data-days="15">
            <p class="race-label">都度外注の例</p>
            <div class="race-track">
              <span class="seg seg-a" style="--from:0;--to:3">探す・見積もり</span>
              <span class="seg seg-b" style="--from:3;--to:5">発注・契約</span>
              <span class="seg seg-c" style="--from:5;--to:15">制作・修正</span>
              <em class="race-done">納品</em>
            </div>
          </div>

          <div class="race-row race-row-ours" data-days="2">
            <p class="race-label">サブスク<small>バナー</small></p>
            <div class="race-track">
              <span class="seg seg-ours" style="--from:0;--to:2">制作</span>
              <em class="race-done" style="--at:2" set:html={`${svg("check", "ic ic-sm")}納品`} />
            </div>
          </div>

          <div class="race-row race-row-ours" data-days="3">
            <p class="race-label">サブスク<small>LP</small></p>
            <div class="race-track">
              <span class="seg seg-ours" style="--from:0;--to:3">制作</span>
              <em class="race-done" style="--at:3" set:html={`${svg("check", "ic ic-sm")}納品`} />
            </div>
          </div>

          <p class="race-note">※都度外注の日数は一般的な進行の一例です。サブスクの日数は目安で、内容・分量・依頼の順番により変動します。</p>
        </div>

        <dl class="speed-stats">
          <div>
            <dt>バナー・SNS画像</dt>
            <dd><strong data-count="2">2</strong>営業日<small>目安</small></dd>
          </div>
          <div>
            <dt>LP</dt>
            <dd><strong data-count="3">3</strong>営業日<small>目安</small></dd>
          </div>
          <div>
            <dt>見積もり・発注書</dt>
            <dd><strong data-count="0">0</strong>回<small>何本頼んでも</small></dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- 04 Service -->
    <section class="service section-block" aria-labelledby="service-title">
      <div class="section-heading">
        <p class="section-kicker">Service</p>
        <h2 id="service-title"><span class="no-break">月額定額で</span><wbr /><span class="no-break">「頼んで、受け取って、</span><wbr /><span class="no-break">また頼む」だけ。</span></h2>
        <p class="section-lead">ご契約後は、<span class="no-break">専用チャットに</span>依頼を送るだけ。<span class="no-break">見積もり</span>も発注書も、もう<span class="no-break">必要ありません。</span>制作は<span class="no-break">同時進行1件ずつ</span>、<span class="no-break">依頼リスト</span>の上から順に丁寧に<span class="no-break">お届けします。</span></p>
      </div>
      <ol class="loop-visual" aria-label="依頼から納品までのループ">
        <li>
          <span class="loop-step">1</span>
          <h3>依頼を送る</h3>
          <p>チャットに要望を書くだけ。丸投げでもOK。</p>
        </li>
        <li>
          <span class="loop-step">2</span>
          <h3>制作</h3>
          <p>専属デザイナーが<span class="no-break">スピーディーに制作。</span></p>
        </li>
        <li>
          <span class="loop-step">3</span>
          <h3>納品・修正</h3>
          <p>確認して修正依頼。修正回数は無制限。</p>
        </li>
        <li class="loop-return">
          <span class="loop-step">↻</span>
          <h3>次の依頼へ</h3>
          <p>完了したら、そのまま次の制作に着手します。</p>
        </li>
      </ol>
