        </div>

        <div class="lead-form-row">
          <label class="form-field">
            <span class="form-label">ご相談内容（任意）</span>
            <textarea name="challenges" rows="4" placeholder="例：毎月バナーやチラシを外注しており、外注費は月20万円ほど。サブスクに切り替えられるか相談したい。"></textarea>
          </label>
        </div>

        <div class="lead-form-row form-field-checkbox form-field-consent">
          <label>
            <input type="checkbox" name="consent" required value="yes" />
            <span>
              <a href="/privacy-policy/" target="_blank" rel="noopener">個人情報の取り扱い</a>に同意の上、送信します<em aria-hidden="true">*</em>
            </span>
          </label>
        </div>

        <div aria-hidden="true" class="form-honeypot">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="lead-form-actions">
          <button type="submit" class="primary-cta lead-form-submit">
            無料で相談してみる<Fragment set:html={svg("arrow")} />
          </button>
          <p class="lead-form-note">送信後、1営業日以内に担当よりご連絡いたします。</p>
        </div>

        <p id="form-feedback" class="form-feedback" role="status" aria-live="polite"></p>
      </form>
    </section>

    <div class="mobile-sticky-cta" id="mobile-sticky-cta">
      <a class="primary-cta" href="#contact-form" data-cta-source="sticky-mobile">
        無料で相談してみる<Fragment set:html={svg("arrow")} />
      </a>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function () {
      const FORM_ENDPOINT = "https://recruit-hp-form-api.vercel.app/api/contact";

      const form = document.getElementById("lead-form");
      if (!form) return;

      const feedback = document.getElementById("form-feedback");
      const submitBtn = form.querySelector(".lead-form-submit");
      const submitHtml = submitBtn.innerHTML;

      // API側の獲得経路ホワイトリストに合わせる。LPの識別は UTM_campaign の既定値で行う
      function resolveSource() {
        return "LP無料相談";
      }

      function collectUtm() {
        try {
          const url = new URL(window.location.href);
          return {
            utmSource: url.searchParams.get("utm_source") || "",
            utmCampaign: url.searchParams.get("utm_campaign") || "subsc-design-lp",
          };
        } catch (_) {
          return { utmSource: "", utmCampaign: "subsc-design-lp" };
        }
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "送信中...";
        feedback.className = "form-feedback";
        feedback.textContent = "";

        const data = new FormData(form);
        const utm = collectUtm();
        const eventId =
          (window.crypto && crypto.randomUUID && crypto.randomUUID()) ||
          String(Date.now()) + Math.random().toString(16).slice(2);
        const payload = {
          source: resolveSource(),
          company: data.get("company"),
          name: data.get("name"),
          email: data.get("email"),
          phone: data.get("phone"),
          challenges: data.get("challenges"),
          consent: data.get("consent") === "yes",
          website: data.get("website") || "",
          utmSource: utm.utmSource,
          utmCampaign: utm.utmCampaign,
          eventId: eventId,
          pageUrl: window.location.href,
        };

        try {
          const res = await fetch(FORM_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));

          if (!res.ok) {
            throw new Error(body.error || "送信に失敗しました");
          }

          feedback.classList.add("is-success");
          feedback.textContent =
            body.message || "お問い合わせを受け付けました。1営業日以内にご連絡いたします。";
          form.reset();
          submitBtn.textContent = "送信完了";

          if (typeof window.gtag === "function") {
            window.gtag("event", "generate_lead", {
              event_category: "form",
              event_label: payload.source,
            });
          }

          if (typeof window.fbq === "function") {
            window.fbq(
              "track",
              "Lead",
              { content_name: payload.source },
              { eventID: eventId }
            );
          }
        } catch (err) {
          feedback.classList.add("is-error");
          feedback.textContent =
            err.message ||
            "送信に失敗しました。お手数ですが info@sai-mon.co.jp まで直接ご連絡ください。";
          submitBtn.disabled = false;
          submitBtn.innerHTML = submitHtml;
        }
      });

      // ===== 計測: GA4ファネルイベント（既存 gtag / BaseLayout 側で読み込み済み） =====
      function track(name, params) {
        try { if (typeof window.gtag === "function") window.gtag("event", name, params || {}); } catch (_) {}
      }

      var stickyCta = document.getElementById("mobile-sticky-cta");
      var formSection = document.getElementById("contact-form");

      // フォーム到達（form_view・1回のみ）＋ 追従CTAはヒーローのCTAかフォームが見えている間は隠す（CTAの二重表示を避ける）
      var formViewed = false;
      var heroCta = document.querySelector('[data-cta-source="hero-primary"]');
      var ctaVisible = { hero: true, form: false };
      function syncSticky() {
        if (stickyCta) stickyCta.classList.toggle("is-hidden", ctaVisible.hero || ctaVisible.form);
      }
      syncSticky();
      if (heroCta && "IntersectionObserver" in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { ctaVisible.hero = e.isIntersecting; syncSticky(); });
        }).observe(heroCta);
      }
      if (formSection && "IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            ctaVisible.form = e.isIntersecting;
            syncSticky();
            if (e.isIntersecting && !formViewed) {
              formViewed = true;
              track("lp_form_view", { event_category: "subsc_design_funnel" });
            }
          });
        }, { threshold: 0.01 });
        io.observe(formSection);
      }

      // CTAクリック（data-cta-source 別）
      document.querySelectorAll("[data-cta-source]").forEach(function (el) {
        el.addEventListener("click", function () {
          track("lp_cta_click", { event_category: "subsc_design_funnel", event_label: el.getAttribute("data-cta-source") });
        });
      });

      // フォーム入力開始（最初のフォーカス・1回のみ）
      var formStarted = false;
      form.addEventListener("focusin", function () {
        if (formStarted) return;
        formStarted = true;
        track("lp_form_start", { event_category: "subsc_design_funnel" });
      });

      // ===== コスト診断（リードマグネット） =====
      (function () {
        var UNIT = { banner: 2, flyer: 5, lp: 30 }; // 万円/本（一般的な外注相場の概算）
        var PLAN = {
          light: { name: "ライトプラン", monthly: 11, annual: 132 },
          standard: { name: "スタンダードプラン", monthly: 22, annual: 264 },
        };
        var runBtn = document.getElementById("sd-run");
        if (!runBtn) return;
        var last = null;

        function num(id) {
          var v = parseInt(document.getElementById(id).value, 10);
          return isNaN(v) || v < 0 ? 0 : Math.min(v, 99);
        }

        runBtn.addEventListener("click", function () {
          var banner = num("sd-banner");
          var flyer = num("sd-flyer");
          var lp = num("sd-lp");
          var monthly = banner * UNIT.banner + flyer * UNIT.flyer + lp * UNIT.lp;
          var annual = monthly * 12;
          var plan = lp > 0 ? PLAN.standard : PLAN.light;
          var diffM = monthly - plan.monthly;
          var diffY = annual - plan.annual;

          function setNum(id, v) {
            var el = document.getElementById(id);
            if (window.sdCountUp) window.sdCountUp(el, v);
            else el.textContent = v.toLocaleString();
          }
          setNum("sd-current", monthly);
          setNum("sd-current-y", annual);
          setNum("sd-subsc", plan.monthly);
          setNum("sd-subsc-y", plan.annual);
          document.getElementById("sd-plan").textContent = "（" + plan.name + "）";

          var diffLabel = document.getElementById("sd-diff-label");
          var comment = document.getElementById("sd-comment");
          setNum("sd-diff", Math.abs(diffM));
          setNum("sd-diff-y", Math.abs(diffY));
          if (diffM > 0) {
            diffLabel.textContent = "削減見込み";
            comment.textContent = "外注のたびに発生する見積もり・発注のやりとりもなくなります。診断結果をもとに、最適なプランを無料相談でご案内します。";
          } else if (diffM === 0) {
            diffLabel.textContent = "サブスクとの差額";
            comment.textContent = "外注費はサブスクとほぼ同水準です。依頼のしやすさや品質の安定、納品スピードを重視される場合は、ぜひ一度ご相談ください。";
          } else {
            diffLabel.textContent = "サブスクとの差額";
            comment.textContent = "現在の本数では単発外注のほうが割安な可能性があります。制作本数を増やしたい場合や、スピード・品質に課題がある場合は、シェア利用も含めてご相談ください。";
          }
          last = { banner: banner, flyer: flyer, lp: lp, monthly: monthly, annual: annual, plan: plan.name, diffM: diffM, diffY: diffY };
          document.getElementById("sd-result").hidden = false;
          track("lp_shindan_run", { event_category: "subsc_design_funnel", value: monthly });
        });

        document.getElementById("sd-consult").addEventListener("click", function () {
          if (last) {
            var ta = document.querySelector('#lead-form textarea[name="challenges"]');
            if (ta && !ta.value) {
              ta.value =
                "【外注費診断の結果】バナー" + last.banner + "本・チラシ等" + last.flyer + "本・LP" + last.lp +
                "本（いずれも月間）→ 外注費 月約" + last.monthly + "万円（年約" + last.annual + "万円）。" +
                (last.diffM > 0 ? "サブスク切替（" + last.plan + "）で月約" + last.diffM + "万円・年約" + last.diffY + "万円の削減見込みと診断されました。詳しく相談したいです。" : "最適な利用方法を相談したいです。");
            }
          }
          track("lp_shindan_cta", { event_category: "subsc_design_funnel" });
          var formSec = document.getElementById("contact-form");
          if (formSec) formSec.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      })();

      // スクロール深度（25/50/75/100% を1回ずつ）
      var depths = [25, 50, 75, 100];
      var fired = {};
      function onScroll() {
        var doc = document.documentElement;
        var scrolled = (window.scrollY + window.innerHeight) / doc.scrollHeight * 100;
        depths.forEach(function (d) {
          if (!fired[d] && scrolled >= d) {
            fired[d] = true;
            track("lp_scroll_depth", { event_category: "subsc_design_funnel", event_label: d + "%", value: d });
          }
        });
        if (fired[100]) window.removeEventListener("scroll", onScroll);
      }
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>

  <script is:inline>
    // ===== モーション層（reduced-motion 尊重） =====
    (function () {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var scope = document.querySelector(".sd-scope");
      if (!scope) return;

      // ---- スクロール連動リビール ----
      var targets = scope.querySelectorAll(
        ".section-heading, .large-text, .check-list li, .race, .speed-stats > div, .loop-visual li, .service-terms > div, .reason-card, .work-card, .plan-card, .share-panel, .shindan-form, .compare-scroll, .flow-steps li, .faq-list details, .lead-form"
      );
      if (reduce || !("IntersectionObserver" in window)) {
        targets.forEach(function (el) { el.classList.add("rv-in"); });
      } else {
        targets.forEach(function (el, i) {
          el.classList.add("rv");
          el.style.transitionDelay = (i % 4) * 70 + "ms";
        });
        var rio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("rv-in");
              rio.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
        targets.forEach(function (el) { rio.observe(el); });
      }

      // ---- 数字のカウントアップ（rAFが使えない環境でも最終値は必ず表示される） ----
      window.sdCountUp = function (el, to) {
        el.textContent = to.toLocaleString();
        if (reduce || to <= 0 || typeof requestAnimationFrame !== "function") return;
        var dur = 600, t0 = null;
        el.textContent = "0";
        function step(t) {
          if (!t0) t0 = t;
          var p = Math.min((t - t0) / dur, 1);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString();
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      };

      // ---- 03 Speed: 納品までの日数レース（CSSトランジション＋タイマー。rAF非依存） ----
      var race = document.getElementById("race");
      if (race) {
        var dayEl = document.getElementById("race-day");
        var TOTAL = 15, DUR = 5200;
        function runRace() {
          race.classList.remove("is-run", "is-end");
          race.querySelectorAll(".race-row").forEach(function (r) { r.classList.remove("is-done"); });
          void race.offsetWidth;
          race.classList.add("is-run");
          var day = 0;
          dayEl.textContent = "0";
          var timer = setInterval(function () {
            day++;
            dayEl.textContent = String(day);
            race.querySelectorAll(".race-row").forEach(function (r) {
              if (+r.getAttribute("data-days") <= day) r.classList.add("is-done");
            });
            if (day >= TOTAL) {
              clearInterval(timer);
              race.classList.add("is-end");
            }
          }, DUR / TOTAL);
        }
        if (reduce || !("IntersectionObserver" in window)) {
          race.classList.add("is-run", "is-end", "no-anim");
          race.querySelectorAll(".race-row").forEach(function (r) { r.classList.add("is-done"); });
          dayEl.textContent = String(TOTAL);
        } else {
          var raceIO = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { runRace(); raceIO.disconnect(); }
            });
          }, { threshold: 0.45 });
          raceIO.observe(race);
          var replay = document.createElement("button");
          replay.type = "button";
          replay.className = "race-replay";
          replay.setAttribute("aria-label", "もう一度再生");
          replay.title = "もう一度再生";
          replay.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>';
          replay.addEventListener("click", runRace);
          race.querySelector(".race-head").appendChild(replay);
        }
      }

      // ---- 01 Hero: 作品壁（弧状に流れ、中央手前で1枚ずつ組み上がる） ----
      var wall = document.getElementById("wall");
      if (!wall) return;
      var heroSec = wall.closest(".hero");
      var cards = Array.prototype.slice.call(wall.querySelectorAll(".wc")).map(function (el) {
        return { el: el, w: 0, s: 0, built: false, video: el.querySelector("video") };
      });
      // 動画は組み上がり演出をかけず、常に完成状態で再生し続ける
      cards.forEach(function (c) { if (c.video) c.el.classList.add("is-built", "is-done", "is-static"); });
      var L = 1, R = 1500, gap = 28, speed = 60, tOff = 0, vw = window.innerWidth;

      function cssNum(name, def) {
        var v = parseFloat(getComputedStyle(wall).getPropertyValue(name));
        return isNaN(v) ? def : v;
      }
      function measure() {
        vw = window.innerWidth;
        gap = cssNum("--gap", 28);
        R = cssNum("--radius", 1500);
        speed = cssNum("--speed", 60);
        var acc = 0;
        cards.forEach(function (c) {
          c.w = c.el.offsetWidth;
          c.s = acc + c.w / 2;
          acc += c.w + gap;
        });
        L = acc;
      }
      function buildX() { return vw * (vw < 700 ? 0.18 : 0.26); }
      function setBuilt(c, animate) {
        c.built = true;
        if (!animate) {
          c.el.classList.add("no-tr", "is-built", "is-done");
          void c.el.offsetWidth;
          c.el.classList.remove("no-tr");
          return;
        }
        c.el.classList.add("is-building");
        setTimeout(function () { c.el.classList.add("is-built"); }, 380);
        setTimeout(function () { c.el.classList.remove("is-building"); c.el.classList.add("is-done", "is-pop"); }, 1900);
      }
      function reset(c) {
        c.built = false;
        c.el.classList.add("no-tr");
        c.el.classList.remove("is-built", "is-done", "is-building", "is-pop");
        void c.el.offsetWidth;
        c.el.classList.remove("no-tr");
      }
      function place(animateBuild) {
        var half = L / 2, bx = buildX();
        cards.forEach(function (c) {
          var x = ((c.s - tOff) % L + L) % L - half;
          var th = x / R;
          var a = Math.abs(th);
          var tx = R * Math.sin(th) - c.w / 2;
          var tz = R * (Math.cos(th) - 1);
          c.el.style.transform = "translate3d(" + tx.toFixed(1) + "px,0," + tz.toFixed(1) + "px) rotateY(" + (-th * 38).toFixed(2) + "deg)";
          c.el.style.opacity = a > 1.25 ? 0 : Math.min(1, 1.7 - a * 1.25).toFixed(3);
          c.el.style.zIndex = String(1000 - Math.round(a * 100));
          if (c.video) return;
          if (!c.built && x < bx && x > bx - 600) setBuilt(c, animateBuild);
          else if (c.built && x > bx + 40) reset(c);
          if (animateBuild === false && !c.built && x < bx) setBuilt(c, false);
        });
      }

      measure();
      if (reduce) {
        tOff = cards[Math.floor(cards.length / 2)].s;
        place(false);
        cards.forEach(function (c) { if (!c.built) setBuilt(c, false); });
        return;
      }
      tOff = cards[3].s - vw * 0.05;
      place(false);

      var running = false, last = 0, usingRaf = false, rafSeen = false, iv = null;
      function step(now) {
        if (!running) return;
        var dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
        last = now;
        tOff += speed * dt;
        place(true);
      }
      function rafLoop(now) {
        rafSeen = true;
        step(now);
        if (running && usingRaf) requestAnimationFrame(rafLoop);
      }
      function start() {
        if (running) return;
        running = true; last = 0;
        usingRaf = typeof requestAnimationFrame === "function";
        if (usingRaf) {
          requestAnimationFrame(rafLoop);
          // rAF が発火しない環境（一部の埋め込みブラウザ）向けのフォールバック
          setTimeout(function () {
            if (running && !rafSeen) { usingRaf = false; iv = setInterval(function () { step(performance.now()); }, 33); }
          }, 400);
        } else {
          iv = setInterval(function () { step(performance.now()); }, 33);
        }
        cards.forEach(function (c) { if (c.video) { c.video.preload = "auto"; var p = c.video.play(); if (p && p.catch) p.catch(function () {}); } });
      }
      function stop() {
        running = false;
        if (iv) { clearInterval(iv); iv = null; }
        cards.forEach(function (c) { if (c.video) c.video.pause(); });
      }
      var heroIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) start(); else stop(); });
      }, { threshold: 0.05 });
      heroIO.observe(heroSec);
      document.addEventListener("visibilitychange", function () {
        if (document.hidden) stop();
        else if (heroSec.getBoundingClientRect().bottom > 0) start();
      });
      var rz;
      window.addEventListener("resize", function () {
        clearTimeout(rz);
        rz = setTimeout(function () { measure(); place(false); }, 150);
      });
    })();
  </script>

  <script>
    // BudouX: 日本語の文節を自動判定して本文を折り返す（両端揃えと併用で右端をそろえる）
    import { loadDefaultJapaneseParser } from "budoux";
    const parser = loadDefaultJapaneseParser();
    const sel = [
      ".sd-scope .section-lead",
      ".sd-scope .large-text",
      ".sd-scope .hero-lead",
      ".sd-scope .reason-card p",
      ".sd-scope .work-body p",
      ".sd-scope .check-list li",
      ".sd-scope .loop-visual p",
      ".sd-scope .flow-steps p",
      ".sd-scope .faq-list details p",
      ".sd-scope .works-note",
      ".sd-scope .race-note",
      ".sd-scope .share-copy p",
      ".sd-scope .cta-band p",
      ".sd-scope .contact-form-lead",
    ].join(",");
    document.querySelectorAll(sel).forEach((el) => {
      try {
        parser.applyToElement(el);
      } catch (e) {}
    });
  </script>
