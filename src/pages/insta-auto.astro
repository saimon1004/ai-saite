---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import { loadDefaultJapaneseParser } from "budoux";

// アプリ画面モックの文字は幅が狭く、word-break:keep-all だけだと折り返せずはみ出す。
// ビルド時に文節境界へ ZWSP を入れておく。
const jpParser = loadDefaultJapaneseParser();
const ZWSP = String.fromCharCode(0x200b);
const phrase = (t: string) => jpParser.parse(t).join(ZWSP);

const base = import.meta.env.BASE_URL;
// CSSはXserverで1年間キャッシュされるため、内容変更時はバージョンを上げてキャッシュバストする
const cssVersion = "20260827-v18";
const cssHref = `${base}insta-auto/styles.css?v=${cssVersion}`;

const img = (name: string) => `${base}insta-auto/assets/${name}`;
const feedHero = img("feed-main-v.jpg");
const bandKitchen = img("band-kitchen.jpg");
const bandCta = img("band-cta.jpg");
const dishA = img("dish-a.jpg");
const dishB = img("dish-b.jpg");
const feedSalad = img("feed-salad.jpg");
const feedParfait = img("feed-parfait.jpg");
const feedCafe = img("feed-cafe.jpg");
const reelStill = img("reel-still.jpg");
// 加工前の1枚は「店側が出す直前に厨房でさっと撮ったもの」。客席で客が撮った写真ではない
const prepWide = img("prep-wide.jpg");

// ヒーローの投稿グリッド（大1＋小3）。おまかせグラムの成果物そのものを最初に見せる。
const feedSubs = [
  { src: feedSalad, alt: "彩り野菜のサラダの投稿写真。" },
  { src: feedParfait, alt: "季節のフルーツパフェの投稿写真。" },
  { src: img("feed-drink.jpg"), alt: "グラスに注がれた自家製サングリアの投稿写真。" },
];

// できあがる投稿のサンプル。画像に載る文字（装飾テンプレート）は焼き込まずCSSで重ねる。
// キャプションは「AIが作る文章の例」であり、実物の出力ではない旨をセクション末尾に明記している。
const samples = [
  {
    img: img("sample-pasta.jpg"),
    alt: "バジルのジェノベーゼ。白い器に盛られたパスタとミニトマト。",
    badge: "",
    copy: "",
    name: "",
    price: "",
    mode: "装飾なし（写真だけの上品な見せ方）",
    title: "バジルのジェノベーゼ",
    caption: "バジルは今朝、店の裏の鉢から摘みました。チーズは削りたてをそのままのせています。麺は少し固めにゆでました。",
    tags: "#本町ランチ #ジェノベーゼ #自家製バジル #本町パスタ",
  },
  {
    img: img("sample-kaisen.jpg"),
    alt: "海鮮丼。まぐろ・サーモン・いくらなどをのせた丼。",
    badge: "本日のおすすめ",
    copy: "今朝入荷",
    name: "",
    price: "",
    mode: "装飾あり（バッジ＋ひとこと）",
    title: "海鮮丼",
    caption: "今朝入ったばかりの魚を、七種のせました。数に限りがあるので、なくなり次第終わりです。ランチは11時半からです。",
    tags: "#本町ランチ #海鮮丼 #日替わり #本町ディナー",
  },
  {
    img: img("sample-curry.jpg"),
    alt: "スパイスチキンカレー。白い皿に盛られたカレーとライス。",
    badge: "",
    copy: "",
    name: "スパイスチキンカレー",
    price: "¥1,180",
    mode: "装飾あり（メニュー名＋価格）",
    title: "スパイスチキンカレー",
    caption: "10種類のスパイスを自分のところで挽いています。辛さは3段階から選べます。ライスの大盛りは無料です。",
    tags: "#本町ランチ #スパイスカレー #カレー好きと繋がりたい",
  },
];

const pageUrl = "https://sai-mon.co.jp/insta-auto/";

// 投稿1本あたりの工程と担当。ページの核なので、ここを唯一の情報源にして表を描く。
// お店に残る操作は op（①送る／②承認する）で示す。行は3つあるが操作は2つ、というのが要点。
const compareRows = [
  { step: "料理の写真を撮る", before: "お店", owner: "shop", after: "お店", note: "アプリから送ります", op: "①" },
  { step: "投稿に使う写真を選ぶ", before: "お店", owner: "shop", after: "お店", note: "送るときに一緒に選びます（①と同じ操作です）", op: "①" },
  { step: "トリミングして明るさを整える", before: "お店", owner: "ai", after: "AI", note: "料理に寄せて、控えめに補正します", op: "" },
  { step: "画像に文字やバッジを載せる", before: "お店", owner: "ai", after: "AI", note: "登録した装飾テンプレートに沿って作ります", op: "" },
  { step: "キャプションを考える", before: "お店", owner: "ai", after: "AI", note: "店舗プロフィールと作成ルールに沿って作ります", op: "" },
  { step: "ハッシュタグを調べて選ぶ", before: "お店", owner: "ai", after: "AI", note: "形式とルールに合わせて付けます", op: "" },
  { step: "投稿する時間を決めて投稿する", before: "お店", owner: "shop", after: "お店（承認）＋自動", note: "承認すると、決めた時間に投稿されます", op: "②" },
];

// FAQ は本文の <details> と JSON-LD の両方をこの配列から描く（文言のズレを構造的に防ぐ）
const faqs = [
  {
    q: "勝手に投稿されることはありませんか？",
    a: "投稿はすべて、お店の承認を経てから公開されます。承認していない投稿案が、そのまま公開されることはありません。承認したあとでも、予定・履歴から日時の変更や取り消しができます。",
  },
  {
    q: "Instagramのアカウントは何が必要ですか？",
    a: "Instagramのビジネスアカウントと、連携するFacebookページをご用意ください。ご用意いただくのはこの2つだけです。接続の手順はお申し込み後にご案内します。",
  },
  {
    q: "写真は何枚送ればいいですか？",
    a: "投稿の形式によって変わります。フィードは写真1枚、カルーセルは最大10枚まで並べられ、動画のスライドも入れられます。リールは動画1本を60秒までお送りください。操作はどの形式でも同じで、送るものが変わるだけです。",
  },
  {
    q: "AIが作った文章は直せますか？",
    a: "直せます。承認画面でタイトルとキャプションをその場で書き換えられます。文章そのものが気に入らないときは、AIで別の案を作り直すこともできます。",
  },
  {
    q: "料理の写真をAIが描き換えたりしませんか？",
    a: "描き換えません。生成AIで画像を作り直すことはせず、お店で撮った写真を、トリミングと控えめな補正で整えるだけにとどめています。来店されたときに実物と違って見えることを避けるためです。",
  },
  {
    q: "メニュー名や価格を間違えられませんか？",
    a: "正式なメニュー名と価格をあらかじめ登録しておき、その内容と照合します。AIに料理名を推測させない仕組みです。名前の誤りはお店の信用に関わるため、ここは推測に任せていません。",
  },
  {
    q: "投稿する時間は選べますか？",
    a: "選べます。頻度と時間帯を投稿ルールとして決めておくと、承認した投稿がその時間に合わせて予約されます。カレンダーで月ごとの予定を確認でき、ドラッグで日付を移したり、ワンタップで取り消したりできます。",
  },
  {
    q: "アプリのインストールは必要ですか？",
    a: "必要ありません。ブラウザで開いてホーム画面に追加していただければ、アプリと同じように使えて、通知も届きます。",
  },
  {
    q: "Instagramの仕様が変わったらどうなりますか？",
    a: "ハッシュタグの上限など、変わり続ける仕様は運営側で更新します。お店側で対応していただくことはありません。",
  },
  {
    q: "投稿に失敗したらどうなりますか？",
    a: "自動でやり直します。結果は通知でお知らせしますので、投稿できていたかどうかを確認できます。",
  },
  {
    q: "複数の店舗で使えますか？",
    a: "使えます。店舗ごとにデータを分けて管理するので、系列店でも投稿が混ざりません。料金は1店舗あたりの月額で、複数店舗でのご利用は個別にお見積もりします。",
  },
  {
    q: "料金はいくらですか？",
    a: "初期費用は0円、1店舗あたり月額30,000円（税別）です。アプリ、AIによる画像の加工と文章の作成、承認後の予約投稿と自動投稿、各種ルールの設定、Instagramの仕様変更への追従が含まれます。",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sai-mon.co.jp/#organization",
      name: "株式会社SAIMON",
      url: "https://sai-mon.co.jp/",
      logo: "https://sai-mon.co.jp/og-image.png",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "おまかせグラム",
      serviceType: "飲食店向けInstagram運用自動化サービス",
      description:
        "飲食店のInstagram運用を、写真を送ることと投稿案を承認することの2工程にするサービス。AIが写真の加工と文章・ハッシュタグの作成を行い、店主が承認すると決めた時間に投稿されます。フィード・カルーセル・リールに対応し、スマホだけで操作が完結します。",
      url: pageUrl,
      provider: { "@id": "https://sai-mon.co.jp/#organization" },
      areaServed: "JP",
      audience: {
        "@type": "Audience",
        audienceType: "カフェ・居酒屋・レストランなどの飲食店",
      },
      offers: {
        "@type": "Offer",
        name: "1店舗あたり",
        price: "30000",
        priceCurrency: "JPY",
        description:
          "初期費用0円。店舗アプリ、AIによる画像加工と文章・ハッシュタグの作成、承認後の予約投稿と自動投稿、メニュー・作成ルール・装飾テンプレート・投稿ルールの設定、Instagramの仕様変更への追従を含む月額プラン（税別・1店舗あたり）。複数店舗でのご利用は個別見積。",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "30000",
          priceCurrency: "JPY",
          valueAddedTaxIncluded: false,
          unitCode: "MON",
        },
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: "https://sai-mon.co.jp/" },
        { "@type": "ListItem", position: 2, name: "おまかせグラム", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  title="おまかせグラム｜写真を送って承認するだけの飲食店Instagram運用"
  description="飲食店のInstagram運用を自動化する「おまかせグラム」。料理の写真を送ると、AIが加工と文章・ハッシュタグを用意します。届いた投稿案をアプリで承認すれば、決めた時間に投稿されます。お店の作業は送ることと承認することの2つだけ。初期費用0円、1店舗あたり月額30,000円（税別）。フィード・カルーセル・リールに対応します。"
  jsonLd={jsonLd}
  chatbot={false}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@600;700;800&display=swap"
    slot="head"
  />
  <link rel="preload" as="image" href={feedHero} slot="head" />
  <link rel="stylesheet" href={cssHref} slot="head" />

  <Header />

  <main class="insta-lp-scope">
    <!-- 01 Hero — 左に明朝の見出し、右に「このお店の投稿グリッド」 -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          {/* スマホではこの塊だけを投稿グリッドの上に重ねる（下のCSS参照）。
              重ねるのは見出しまでで、リード文以降は写真の下に流す。 */}
          <div class="hero-head">
            <p class="hero-kicker">飲食店のInstagram運用<span aria-hidden="true">／</span><b>おまかせグラム</b></p>
            {/* 改行位置は固定する。自動折り返しに任せると幅によって「け。」だけが3行目に落ちる */}
            <h1 id="hero-title">写真を送る。<br />あとは、<br />承認するだけ。</h1>
          </div>
          <p class="hero-lead jp-budoux">料理の写真を送ると、AIが加工と文章を用意します。届いた投稿案をアプリで承認すれば、決めた時間に投稿されます。お店の作業は、送ることと承認することの2つだけです。</p>
          <ul class="hero-facts">
            <li class="hero-fact-zero"><span class="hero-fact-value">初期費用 0円</span><span class="hero-fact-note">はじめる費用はかかりません</span></li>
            <li><span class="hero-fact-value">月額 30,000円<small>（税別）</small></span><span class="hero-fact-note">1店舗あたり</span></li>
            <li><span class="hero-fact-value">承認前は公開されません</span><span class="hero-fact-note">投稿するかどうかの判断はお店に残ります</span></li>
          </ul>
          <div class="hero-actions">
            <a class="primary-cta" href="#contact-form" data-cta-source="hero-primary">無料相談する<span aria-hidden="true">→</span></a>
            <a class="secondary-cta" href="#compare" data-cta-source="hero-compare">何が楽になるか見る</a>
          </div>
          <p class="hero-note jp-budoux">ご用意いただくのは、Instagramのビジネスアカウント（と連携するFacebookページ）だけです。</p>
        </div>

        <div class="feed-collage">
          <figure class="feed-main">
            <img src={feedHero} alt="カウンターに置かれた焼き鳥の一皿の投稿写真。" width="1024" height="1280" fetchpriority="high" decoding="async" />
          </figure>
          {feedSubs.map((s) => (
            <figure class="feed-sub">
              <img src={s.src} alt={s.alt} width="512" height="512" loading="lazy" decoding="async" />
            </figure>
          ))}
          {/* 成果（フィード）の上に、その作り方（承認画面）を小さく重ねる */}
          <div class="phone collage-phone" role="img" aria-label="AIが作った投稿案を承認する画面のイメージ。料理の写真、タイトル、キャプション、ハッシュタグと、文章を直す・承認するのボタンが並んでいる。">
            <div class="phone-screen" aria-hidden="true">
              <p class="mock-bar"><span>承認待ち</span><span>1件</span></p>
              <div class="mock-photo">
                <img src={dishB} alt="" loading="lazy" decoding="async" />
                <span class="mock-photo-badge">{phrase("本日のおすすめ")}</span>
              </div>
              <div class="mock-body">
                <p class="mock-title">{phrase("窯焼きマルゲリータ")}</p>
                <p class="mock-caption">{phrase("生地から仕込んでいます。")}</p>
                <p class="mock-tags">{phrase("#本町ディナー")}</p>
              </div>
              <p class="mock-meta">{phrase("承認すると 18:30 に投稿")}</p>
              <div class="mock-actions">
                <span class="mock-btn">直す</span>
                <span class="mock-btn is-primary">承認</span>
              </div>
            </div>
          </div>
          {/* 後半はスマホでは出さない。承認画面のモックがスマホでは非表示のため */}
          <p class="feed-caption">おまかせグラムで運用した投稿のイメージ。<span class="cap-screen">画面はイメージです。</span></p>
        </div>
      </div>
    </section>

    <!-- 02 Problem -->
    <section class="problem section-block" aria-labelledby="problem-title">
      <div class="section-inner split">
        <div class="section-heading">
          <p class="section-kicker">Problem</p>
          <h2 id="problem-title"><span class="no-break">続けるつもりだったのに、</span><wbr /><span class="no-break">止まってしまう</span></h2>
          <p class="section-lead jp-budoux">投稿が止まるのは、やる気の問題ではありません。1回の投稿に、工程が多すぎるからです。</p>
        </div>
        <div>
          <ul class="rule-list">
            <li>
              <h3>「あとで書こう」で止まっている</h3>
              <p class="jp-budoux">写真は撮ってあるのに、文章とタグを考える時間が取れません。1週間空くと、次の1枚がさらに重くなります。</p>
            </li>
            <li>
              <h3>何を書けばいいか、毎回ゼロから考えている</h3>
              <p class="jp-budoux">料理の説明、締めの一言、付けるタグ。決まった型がないので、毎回同じところで迷います。</p>
            </li>
            <li>
              <h3>外注しても、お店に残る手間がある</h3>
              <p class="jp-budoux">費用の話だけではありません。写真を用意して内容を確認するやりとりは、結局お店の仕事として残ります。</p>
            </li>
            <li>
              <h3>書ける人が抜けると、投稿も止まる</h3>
              <p class="jp-budoux">投稿の型がその人の頭の中にあると、担当が変わったところで雰囲気も更新も途切れます。</p>
            </li>
          </ul>
          <p class="problem-close jp-budoux">どれも、工程が多いことから起きています。</p>
        </div>
      </div>
    </section>

    <!-- 02.5 Why Instagram — 他社調査の引用。自社の実績値ではないので出典を必ず添える -->
    <section class="why section-block" aria-labelledby="why-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-kicker">Why Instagram</p>
          <h2 id="why-title"><span class="no-break">お店選びは、</span><wbr /><span class="no-break">いまInstagramの中で</span><wbr /><span class="no-break">起きています</span></h2>
          <p class="section-lead jp-budoux">「どこで食べるか」を決める場所が変わりました。食べログやぐるなびで探す前に、Instagramで見つけて保存する。その順番が当たり前になっています。</p>
        </div>

        <p class="why-source-label">第三者調査でわかっていること</p>
        <ul class="why-stats">
          <li class="why-stat">
            <p class="why-num">80.8<small>%</small></p>
            <h3><span class="no-break">SNS・動画で</span><wbr /><span class="no-break">飲食店に出会う</span></h3>
            <p class="jp-budoux">Z世代（15〜29歳）が、お店を知るきっかけにしているもの。</p>
          </li>
          <li class="why-stat">
            <p class="why-num">67.5<small>%</small></p>
            <h3><span class="no-break">Instagramで</span><wbr /><span class="no-break">情報を集める</span></h3>
            <p class="jp-budoux">YouTube 48.1%・TikTok 46.1% を上回って最多。</p>
          </li>
          <li class="why-stat">
            <p class="why-num">71.2<small>%</small></p>
            <h3><span class="no-break">Instagramに</span><wbr /><span class="no-break">お店を保存する</span></h3>
            <p class="jp-budoux">Googleマップへの保存 61.1% より多く使われています。</p>
          </li>
          <li class="why-stat">
            <p class="why-num">52.5<small>%</small></p>
            <h3><span class="no-break">全年代でも</span><wbr /><span class="no-break">Instagramを見る</span></h3>
            <p class="jp-budoux">お店探しでよく見るメディアとして、若年層以外にも広がっています。</p>
          </li>
        </ul>

        <p class="why-close jp-budoux"><strong>Instagramの価値は、フォロワー数ではなく「保存されること」にあります。</strong>行きたいお店として保存され、お腹が空いたときに思い出してもらえるかどうか。ただし、保存はお客様が投稿を見た瞬間にしか起きません。投稿が止まっている期間の保存は、ゼロです。</p>

        <ul class="why-notes">
          <li>
            <h3><span class="no-break">投稿が見られるのは、</span><wbr /><span class="no-break">出した日です</span></h3>
