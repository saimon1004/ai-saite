      ".insta-lp-scope .step-figure figcaption",
      ".insta-lp-scope .format-item p",
      ".insta-lp-scope .duo-list p",
      ".insta-lp-scope .sample-caption",
      ".insta-lp-scope .admin-grid p",
      ".insta-lp-scope .need-block p",
      ".insta-lp-scope .status-col li",
      ".insta-lp-scope .price-includes li",
      ".insta-lp-scope .photo-compare figcaption",
      ".insta-lp-scope .faq-a",
      ".insta-lp-scope .fine-print",
      ".insta-lp-scope .cta-band p",
      ".insta-lp-scope .contact-form-lead",
    ].join(",");
    document.querySelectorAll(sel).forEach((el) => {
